# ==========================================================================
# Publisher to Word — Environment Variables Template
# Copy this file to `.env` (or `.env.production`) and fill in your values.
# `.env` files are gitignored and must never be committed with live keys.
# ==========================================================================

# Optional: Privacy-friendly, cookie-free Plausible Analytics script URL.
# Only injected during production builds (`npm run build` / `npm run preview`).
# Leave empty or commented out to disable analytics completely.
# Example:
# PLAUSIBLE_SCRIPT_URL=https://plausible.example.com/js/pa-xxxxxxxxxxxxxxxxxxxxx.js
PLAUSIBLE_SCRIPT_URL=
