---
import BaseLayout from "../layouts/BaseLayout.astro";
import { RESCUE_CATEGORIES, RESCUE_ITEMS } from "../data/rescue";

function getCategoryLabel(catId: string): string {
  const found = RESCUE_CATEGORIES.find(c => c.id === catId);
  return found ? found.label : catId;
}
---

<BaseLayout title="Rescue Guide: Why Did That Happen?">
  <main id="content" class="page-main rescue-main" tabindex="-1">
    <div class="page-header">
      <span class="badge badge-ribbon">Troubleshooting</span>
      <h1>"Why Did That Happen?" Rescue Guide</h1>
      <p class="lead">
        Frustrated by jumping pictures, missing ribbon tabs, or mysterious extra pages? Here is why Word behaves differently from Publisher, and the immediate steps to fix it.
      </p>
    </div>

    <!-- Filter & Search Toolbar -->
    <section class="filter-section" aria-labelledby="filter-heading">
      <h2 id="filter-heading" class="visually-hidden">Filter Troubleshooting Snags</h2>

      <div class="filter-toolbar">
        <div class="search-field">
          <label for="rescue-search" class="search-label">
            <span class="search-icon" aria-hidden="true">🔍</span>
            <span>Search troubleshooting snags:</span>
          </label>
          <input
            type="search"
            id="rescue-search"
            class="search-input"
            placeholder="Filter by symptom, tool or keyword (e.g. jumping picture, white fill, margins)..."
            autocomplete="off"
            spellcheck="false"
          />
        </div>

        <div class="controls-row">
          <div class="category-pills" role="radiogroup" aria-label="Filter by category">
            {RESCUE_CATEGORIES.map(cat => (
              <button
                type="button"
                class:list={["pill-btn", { "is-active": cat.id === "all" }]}
                role="radio"
                aria-checked={cat.id === "all" ? "true" : "false"}
                tabindex={cat.id === "all" ? 0 : -1}
                data-category={cat.id}
              >
                <span>{cat.label}</span>
                <span class="pill-count" aria-hidden="true">
                  {cat.id === "all"
                    ? RESCUE_ITEMS.length
                    : RESCUE_ITEMS.filter(item => item.category === cat.id).length}
                </span>
              </button>
            ))}
          </div>

          <div class="actions-group">
            <button
              type="button"
              class="btn btn-secondary toggle-all-btn"
              id="toggle-all-btn"
              aria-expanded="false"
            >
              <span id="toggle-all-text">Expand All</span>
              <span class="toggle-icon" aria-hidden="true">↕</span>
            </button>
          </div>
        </div>
      </div>

      <div class="filter-status" aria-live="polite" id="filter-status">
        Showing all {RESCUE_ITEMS.length} troubleshooting snags.
      </div>
    </section>

    <!-- Rescue Cards Stack -->
    <div class="rescue-stack" id="rescue-stack">
      {RESCUE_ITEMS.map((item, index) => (
        <details
          class="disclosure rescue-card"
          id={item.id}
          data-category={item.category}
          data-id={item.id}
        >
          <summary class="rescue-summary">
            <span class="symptom-wrapper">
              <span class="snag-number" aria-hidden="true">#{index + 1}</span>
              <span class="symptom-text">{item.symptom}</span>
            </span>
            <span class="badge badge-category">{getCategoryLabel(item.category)}</span>
          </summary>

          <div class="rescue-body">
            <div class="rescue-section cause-section">
              <h2 class="section-label">Why Word behaves this way</h2>
              <p class="cause-text">{item.cause}</p>
            </div>

            <div class="rescue-section fix-section">
              <h2 class="section-label">How to fix it (Step-by-Step)</h2>
              <ol class="fix-steps">
                {item.fixSteps.map(step => (
                  <li>{step}</li>
                ))}
              </ol>
            </div>

            <div class="rescue-section paths-section">
              <h2 class="section-label">Where to find the controls</h2>
              <div class="paths-grid">
                <div class="path-card">
                  <span class="path-title">Ribbon Path</span>
                  <code class="path-code">{item.ribbonPath}</code>
                </div>
                {item.altPath && (
                  <div class="path-card">
                    <span class="path-title">Alternative / Shortcut</span>
                    <code class="path-code">{item.altPath}</code>
                  </div>
                )}
              </div>

              {item.tip && (
                <div class="tip-card">
                  <span class="tip-icon" aria-hidden="true">💡</span>
                  <div class="tip-content">
                    <strong>Practical Tip:</strong> {item.tip}
                  </div>
                </div>
              )}
            </div>

            <div class="rescue-footer">
              <a href={`/lessons/${item.lessonSlug}`} class="lesson-link">
                <span>Read related lesson: <strong>{item.lessonTitle}</strong></span>
                <span class="link-arrow" aria-hidden="true">→</span>
              </a>
              {item.sandboxUrl && (
                <a href={item.sandboxUrl} class="sandbox-link">
                  <span>Practise in interactive sandbox</span>
                  <span class="link-arrow" aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </div>
        </details>
      ))}

      <!-- Empty State -->
      <div id="rescue-empty" class="card empty-state" hidden>
        <span class="empty-icon" aria-hidden="true">🔎</span>
        <h3 class="empty-title">No matching troubleshooting snags found</h3>
        <p class="empty-desc">
          We could not find any issue matching your current search term or category filter.
        </p>
        <button type="button" class="btn btn-primary" id="reset-filters-btn">
          <span>Reset All Filters</span>
          <span aria-hidden="true">↺</span>
        </button>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { initRescueController } from "../utils/reference-controllers";

  initRescueController();
</script>

<style>
  .page-header {
    margin-block-end: var(--space-6);
    padding-block-end: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .lead {
    font-size: var(--font-size-lg);
    color: var(--ink-secondary);
    line-height: var(--line-height-relaxed);
    margin-block-start: var(--space-3);
  }

  /* Filter Section */
  .filter-section {
    background-color: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-block-end: var(--space-6);
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 4%);
  }

  .filter-toolbar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .search-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .search-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    font-size: var(--font-size-sm);
    color: var(--ink-primary);
  }

  .search-icon {
    font-size: 1rem;
  }

  .search-input {
    inline-size: 100%;
    min-block-size: var(--target-min-size);
    padding: var(--space-3) var(--space-4);
    font-family: inherit;
    font-size: var(--font-size-base);
    color: var(--ink-primary);
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-md);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .search-input:focus-visible {
    border-color: var(--accent-word);
    box-shadow: 0 0 0 3px rgb(15 82 186 / 15%);
  }

  .controls-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pill-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--target-min-size);
    padding: var(--space-2) var(--space-4);
    font-family: inherit;
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--ink-secondary);
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .pill-btn:hover {
    color: var(--ink-primary);
    border-color: var(--ink-muted);
    background-color: var(--surface-hover);
  }

  .pill-btn.is-active {
    background-color: var(--accent-word);
    color: #ffffff;
    border-color: var(--accent-word);
  }

  .pill-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-pill);
    background-color: rgb(0 0 0 / 8%);
    color: inherit;
  }

  .pill-btn.is-active .pill-count {
    background-color: rgb(255 255 255 / 25%);
    color: #ffffff;
  }

  .toggle-all-btn {
    font-size: var(--font-size-sm);
    padding-inline: var(--space-4);
  }

  .toggle-icon {
    font-size: 1rem;
    margin-inline-start: var(--space-1);
  }

  .filter-status {
    margin-block-start: var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--ink-muted);
    font-style: italic;
  }

  /* Rescue Stack */
  .rescue-stack {
    display: flex;
    flex-direction: column;
  }

  .rescue-card {
    background-color: var(--surface-card);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-lg);
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 4%);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .rescue-card:not([hidden="until-found"]) {
    margin-block-end: var(--space-4);
  }

  .rescue-card[hidden]:not([hidden="until-found"]),
  .empty-state[hidden] {
    display: none !important;
  }

  /* When filtered out with hidden="until-found", collapse outer box and margins completely while preserving search discovery */
  .rescue-card[hidden="until-found"] {
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    box-shadow: none !important;
    block-size: 0 !important;
    min-block-size: 0 !important;
    overflow: hidden !important;
  }

  .rescue-card[hidden="until-found"] > summary {
    display: none !important;
  }

  .rescue-card:hover {
    border-color: var(--accent-word);
  }

  .rescue-card[open] {
    border-color: var(--accent-word);
    box-shadow: 0 2px 6px 0 rgb(15 82 186 / 8%);
  }

  .rescue-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    font-size: var(--font-size-lg);
    font-weight: 600;
    cursor: pointer;
  }

  .symptom-wrapper {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex: 1;
  }

  .snag-number {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--ink-muted);
  }

  .symptom-text {
    color: var(--ink-primary);
  }

  .rescue-card[open] .symptom-text {
    color: var(--accent-word);
  }

  .badge-category {
    font-size: var(--font-size-xs);
    background-color: var(--surface-subtle);
    color: var(--ink-secondary);
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
  }

  .rescue-card::details-content {
    padding: 0;
  }

  .rescue-body {
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    background-color: var(--surface-subtle);
  }

  .section-label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
    margin: 0;
    margin-block-end: var(--space-2);
  }

  .cause-section {
    background-color: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .cause-text {
    color: var(--ink-primary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  .fix-section {
    background-color: var(--accent-success-bg);
    border: 1px solid var(--accent-success-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .fix-section .section-label {
    color: var(--accent-success);
  }

  .fix-steps {
    margin: 0;
    padding-inline-start: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--ink-primary);
    line-height: var(--line-height-relaxed);
  }

  .fix-steps li {
    padding-inline-start: var(--space-1);
  }

  .paths-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .paths-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-3);
  }

  .path-card {
    background-color: var(--surface-card);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .path-title {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .path-code {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--ink-primary);
    background-color: var(--surface-subtle);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    overflow-wrap: anywhere;
  }

  .tip-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background-color: var(--accent-tip-bg);
    border: 1px solid var(--accent-tip-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--font-size-sm);
    color: var(--ink-primary);
  }

  .tip-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .tip-content {
    line-height: var(--line-height-relaxed);
  }

  .rescue-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-start: var(--space-3);
    border-top: 1px solid var(--border-subtle);
  }

  .lesson-link,
  .sandbox-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--accent-word);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background-color: var(--surface-card);
    border: 1px solid var(--border-ui);
    transition: all 0.15s ease;
  }

  .lesson-link:hover,
  .sandbox-link:hover {
    background-color: var(--accent-word);
    color: #ffffff;
    border-color: var(--accent-word);
  }

  .lesson-link:hover strong {
    color: #ffffff;
  }

  .link-arrow {
    transition: transform 0.15s ease;
  }

  .lesson-link:hover .link-arrow,
  .sandbox-link:hover .link-arrow {
    transform: translateX(2px);
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: var(--space-8) var(--space-6);
    background-color: var(--surface-card);
    border: 1px dashed var(--border-ui);
    border-radius: var(--radius-lg);
  }

  .empty-icon {
    font-size: 2.5rem;
    display: block;
    margin-block-end: var(--space-3);
  }

  .empty-title {
    font-size: var(--font-size-xl);
    color: var(--ink-primary);
    margin: 0;
    margin-block-end: var(--space-2);
  }

  .empty-desc {
    color: var(--ink-secondary);
    max-inline-size: 38ch;
    margin-inline: auto;
    margin-block-end: var(--space-5);
  }

  @media (forced-colors: active) {
    .rescue-card {
      border: 1px solid ButtonText !important;
    }

    .rescue-card[open] {
      border: 2px solid Highlight !important;
    }

    .pill-btn.is-active {
      border: 2px solid Highlight !important;
    }
  }
</style>
