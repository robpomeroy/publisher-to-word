---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CURRICULUM } from "../data/curriculum";
---

<BaseLayout title="Home">
  <main id="content" tabindex="-1">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-inner">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge badge-ribbon">A Visual Transition Guide</span>
          </div>
          <h1 class="hero-title">
            Loved Microsoft Publisher?<br />
            Meet Microsoft Word without the headaches.
          </h1>
          <p class="hero-lead">
            Publisher was like a <strong>pinboard</strong>: you placed a box or picture anywhere and it stayed put.
            Word is a <strong>river of text</strong>: everything flows from top to bottom. Once you understand three simple rules, laying out documents in Word becomes calm and predictable.
          </p>
          <div class="hero-actions">
            <a href="/start-here" class="btn btn-primary">
              <span>Start Here (5-Min Orientation)</span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="/lessons/01-how-text-flows" class="btn btn-secondary">
              <span>Jump to Lesson 1</span>
            </a>
          </div>
        </div>

        <!-- Realistic Visual Comparison SVG (WCAG 1.1.1 compliant) -->
        <div class="hero-visual">
          <figure class="comparison-figure">
            <svg viewBox="0 0 460 300" width="100%" height="auto" fill="none" role="img" aria-labelledby="svg-hero-title svg-hero-desc">
              <title id="svg-hero-title">Visual comparison of Microsoft Publisher versus Microsoft Word</title>
              <desc id="svg-hero-desc">Publisher shows independent freeform boxes pinned anywhere on a page, while Word shows text flowing sequentially with images anchored into the text stream.</desc>

              <!-- Publisher Canvas (Left) -->
              <rect x="10" y="20" width="200" height="260" rx="6" fill="#FFFFFF" stroke="#99F6E4" stroke-width="2"/>
              <rect x="10" y="20" width="200" height="28" rx="6" fill="#F0FDFA"/>
              <circle cx="24" cy="34" r="4" fill="#0F766E"/>
              <text x="36" y="38" fill="#0F766E" font-size="11" font-weight="bold" font-family="system-ui">Publisher: Free Pinboard</text>

              <!-- Independent Drag-and-Drop Objects -->
              <rect x="25" y="60" width="90" height="45" rx="3" fill="#E6FFFA" stroke="#0F766E" stroke-width="1.5" stroke-dasharray="3 2"/>
              <text x="32" y="78" fill="#0F766E" font-size="9" font-weight="bold" font-family="system-ui">Title Box</text>
              <text x="32" y="92" fill="#475569" font-size="8" font-family="system-ui">Stays put anywhere</text>

              <rect x="125" y="60" width="70" height="85" rx="3" fill="#FEF3C7" stroke="#D97706" stroke-width="1.5"/>
              <text x="135" y="80" fill="#92400E" font-size="9" font-weight="bold" font-family="system-ui">Photo</text>
              <text x="135" y="94" fill="#78350F" font-size="8" font-family="system-ui">Pinned to</text>
              <text x="135" y="106" fill="#78350F" font-size="8" font-family="system-ui">exact spot</text>

              <rect x="25" y="120" width="90" height="130" rx="3" fill="#F8FAFC" stroke="#94A3B8" stroke-width="1"/>
              <text x="32" y="136" fill="#1E293B" font-size="9" font-weight="bold" font-family="system-ui">Text Column</text>
              <line x1="32" y1="150" x2="105" y2="150" stroke="#CBD5E1" stroke-width="2"/>
              <line x1="32" y1="160" x2="100" y2="160" stroke="#CBD5E1" stroke-width="2"/>
              <line x1="32" y1="170" x2="90" y2="170" stroke="#CBD5E1" stroke-width="2"/>

              <!-- Word Canvas (Right) -->
              <rect x="250" y="20" width="200" height="260" rx="6" fill="#FFFFFF" stroke="#93C5FD" stroke-width="2"/>
              <rect x="250" y="20" width="200" height="28" rx="6" fill="#EFF6FF"/>
              <circle cx="264" cy="34" r="4" fill="#1D4ED8"/>
              <text x="276" y="38" fill="#1D4ED8" font-size="11" font-weight="bold" font-family="system-ui">Word: River of Text</text>

              <!-- Flowing Stream of Text with Anchor -->
              <text x="268" y="65" fill="#1E293B" font-size="10" font-weight="bold" font-family="system-ui">Heading 1 ¶</text>
              <line x1="268" y1="78" x2="430" y2="78" stroke="#94A3B8" stroke-width="2"/>
              <line x1="268" y1="88" x2="420" y2="88" stroke="#94A3B8" stroke-width="2"/>

              <!-- Anchored picture with text wrap -->
              <rect x="268" y="100" width="65" height="60" rx="3" fill="#EFF6FF" stroke="#1D4ED8" stroke-width="1.5"/>
              <circle cx="277" cy="110" r="4" fill="#1D4ED8"/>
              <text x="284" y="113" fill="#1D4ED8" font-size="7" font-weight="bold" font-family="system-ui">⚓ Anchor</text>
              <text x="274" y="132" fill="#1E40AF" font-size="8" font-weight="bold" font-family="system-ui">Square</text>
              <text x="274" y="144" fill="#1E40AF" font-size="8" font-family="system-ui">Wrap</text>

              <!-- Text wrapping around photo -->
              <line x1="340" y1="105" x2="430" y2="105" stroke="#94A3B8" stroke-width="2"/>
              <line x1="340" y1="117" x2="425" y2="117" stroke="#94A3B8" stroke-width="2"/>
              <line x1="340" y1="129" x2="420" y2="129" stroke="#94A3B8" stroke-width="2"/>
              <line x1="340" y1="141" x2="430" y2="141" stroke="#94A3B8" stroke-width="2"/>
              <line x1="340" y1="153" x2="410" y2="153" stroke="#94A3B8" stroke-width="2"/>

              <line x1="268" y1="175" x2="430" y2="175" stroke="#94A3B8" stroke-width="2"/>
              <line x1="268" y1="187" x2="390" y2="187" stroke="#94A3B8" stroke-width="2"/>
              <text x="268" y="210" fill="#B45309" font-size="8" font-weight="bold" font-family="system-ui">⚠️ Enter moves text downstream</text>
            </svg>
            <figcaption class="comparison-caption">
              In Publisher, items are pinned anywhere. In Word, objects anchor to paragraphs in the stream of text.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 4 Modules Overview -->
    <section class="modules-section">
      <div class="section-inner">
        <div class="section-header">
          <h2 class="section-title">Step-by-Step Learning Curriculum</h2>
          <p class="section-desc">Four concise modules designed to take you from initial confusion to complete layout confidence in Microsoft Word.</p>
        </div>

        <div class="modules-grid">
          {CURRICULUM.map(mod => (
            <div class="card module-card">
              <div class="module-card-header">
                <span class="badge badge-ribbon">Module {mod.number}</span>
                <h3 class="module-card-title">{mod.title}</h3>
              </div>
              <p class="module-card-summary">{mod.summary}</p>
              <ul class="module-lesson-list">
                {mod.lessons.map(lesson => (
                  <li>
                    {lesson.isAvailable ? (
                      <a href={`/lessons/${lesson.slug}`} class="module-lesson-link">
                        <span class="lesson-order">{lesson.order}.</span>
                        <span>{lesson.title}</span>
                      </a>
                    ) : (
                      <span class="module-lesson-upcoming">
                        <span class="lesson-order">{lesson.order}.</span>
                        <span>{lesson.title}</span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Quick Reference Tools Callout -->
    <section class="tools-section">
      <div class="section-inner">
        <h2 class="section-title">Companion Reference Tools</h2>
        <div class="tools-grid">
          <div class="card tool-card">
            <h3 class="tool-title">Publisher → Word Translator</h3>
            <p class="tool-desc">Look up familiar Publisher terms (Scratch area, Picture Frame, Master Page) to see their direct Word equivalent.</p>
            <a href="/translator" class="btn btn-secondary">Open Translator →</a>
          </div>

          <div class="card tool-card">
            <h3 class="tool-title">"Why Did That Happen?" Rescue Guide</h3>
            <p class="tool-desc">Visual troubleshooting for when a picture jumps to the next page, buttons disappear, or text boxes misbehave.</p>
            <a href="/rescue" class="btn btn-secondary">View Rescue Guide →</a>
          </div>

          <div class="card tool-card">
            <h3 class="tool-title">Printable Cheat Sheets</h3>
            <p class="tool-desc">1-page clean reference cards you can print out and keep beside your keyboard while working.</p>
            <a href="/cheat-sheet" class="btn btn-secondary">Get Cheat Sheets →</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    background-color: var(--surface-card);
    border-bottom: 1px solid var(--border-subtle);
    padding-block: var(--space-10);
  }

  .hero-inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
  }

  .hero-badge {
    margin-block-end: var(--space-3);
  }

  .hero-title {
    font-size: var(--font-size-3xl);
    line-height: var(--line-height-tight);
    margin-block-end: var(--space-4);
  }

  .hero-lead {
    font-size: var(--font-size-lg);
    color: var(--ink-secondary);
    line-height: var(--line-height-normal);
    max-inline-size: 55ch;
    margin-block-end: var(--space-6);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .comparison-figure {
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 5%);
  }

  .comparison-caption {
    font-size: var(--font-size-sm);
    color: var(--ink-secondary);
    text-align: center;
    margin-block-start: var(--space-2);
  }

  /* Curriculum & Modules */
  .modules-section {
    padding-block: var(--space-10);
  }

  .section-inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  .section-header {
    margin-block-end: var(--space-8);
  }

  .section-title {
    font-size: var(--font-size-2xl);
    margin-block: 0 var(--space-2);
  }

  .section-desc {
    color: var(--ink-secondary);
    font-size: var(--font-size-lg);
    max-inline-size: 60ch;
  }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .module-card {
    display: flex;
    flex-direction: column;
  }

  .module-card-header {
    margin-block-end: var(--space-3);
  }

  .module-card-title {
    font-size: var(--font-size-xl);
    margin-block: var(--space-2) 0;
  }

  .module-card-summary {
    color: var(--ink-secondary);
    font-size: var(--font-size-sm);
    margin-block-end: var(--space-4);
    flex-grow: 1;
  }

  .module-lesson-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border-subtle);
    padding-block-start: var(--space-3);
  }

  .module-lesson-list li {
    margin-block-end: var(--space-2);
    font-size: var(--font-size-sm);
  }

  .module-lesson-link {
    display: flex;
    gap: var(--space-2);
    color: var(--accent-word);
    text-decoration: none;
    font-weight: 600;
  }

  .module-lesson-link:hover {
    text-decoration: underline;
  }

  .module-lesson-upcoming {
    display: flex;
    gap: var(--space-2);
    color: var(--ink-muted);
  }

  .lesson-order {
    flex-shrink: 0;
    width: 1.25rem;
  }

  /* Tools section */
  .tools-section {
    background-color: var(--surface-card);
    border-top: 1px solid var(--border-subtle);
    padding-block: var(--space-10);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    margin-block-start: var(--space-6);
  }

  .tool-card {
    display: flex;
    flex-direction: column;
  }

  .tool-title {
    font-size: var(--font-size-xl);
    margin-block: 0 var(--space-2);
  }

  .tool-desc {
    color: var(--ink-secondary);
    font-size: var(--font-size-sm);
    margin-block-end: var(--space-4);
    flex-grow: 1;
  }
</style>
