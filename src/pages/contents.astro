      { name: "Headers & Footers (Unlinking Previous)", href: "/lessons/13-headers-footers-pages", label: "Lesson 13" },
    ]
  },
  {
    letter: "I",
    topics: [
      { name: "In Front of Text Wrap (Publisher freedom)", href: "/lessons/04-text-wrapping", label: "Lesson 4" },
      { name: "In Line with Text Wrap (Word default)", href: "/lessons/04-text-wrapping", label: "Lesson 4" },
      { name: "Internal Text Box Margins (Padding)", href: "/lessons/06-text-boxes-and-margins", label: "Lesson 6" },
      { name: "Invisible Tables for Side-by-Side Content", href: "/lessons/12-invisible-tables", label: "Lesson 12" },
