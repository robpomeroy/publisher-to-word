    ]
  },
  {
    letter: "T",
    topics: [
      { name: "Table Grids for Layout Alignment", href: "/lessons/12-invisible-tables", label: "Lesson 12" },
      { name: "Text Box Padding (Zero margins)", href: "/lessons/06-text-boxes-and-margins", label: "Lesson 6" },
