    topics: [
      { name: "Distribute Horizontally & Vertically", href: "/lessons/09-align-and-distribute", label: "Lesson 9" },
      { name: "Draw Text Box (Unformatted container)", href: "/lessons/06-text-boxes-and-margins", label: "Lesson 6" },
