      { name: "Floating Layout Options Arch", href: "/lessons/03-finding-the-controls", label: "Lesson 3" },
      { name: "Formatting Marks (Show/Hide ¶)", href: "/lessons/02-show-hidden-clues", label: "Lesson 2" },
