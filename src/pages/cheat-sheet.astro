---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Printable Cheat Sheet">
  <main id="content" class="cheat-main" tabindex="-1">
    <div class="page-header">
      <div class="header-left">
        <span class="badge badge-ribbon">Desk Reference</span>
        <h1>Word Layout Cheat Sheet</h1>
        <p class="lead">
          Print this out and keep it beside your keyboard when laying out flyers, notices, and newsletters.
        </p>
      </div>
      <div class="header-right">
        <button type="button" class="btn btn-primary print-action-btn" data-print-trigger>
          <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5 2.75C5 2.06 5.56 1.5 6.25 1.5h7.5c.69 0 1.25.56 1.25 1.25v2.5H5v-2.5zm-1.5 4h13A2.25 2.25 0 0118.75 9v5A2.25 2.25 0 0116.5 16.25h-1.5V17c0 .69-.56 1.25-1.25 1.25H6.25A1.25 1.25 0 015 17v-.75H3.5A2.25 2.25 0 011.25 14V9A2.25 2.25 0 013.5 6.75zm3 6h7a.75.75 0 00.75-.75V10.5a.75.75 0 00-.75-.75h-7a.75.75 0 00-.75.75v1.5c0 .414.336.75.75.75z" clip-rule="evenodd"/>
          </svg>
          <span>Print This Cheat Sheet</span>
        </button>
      </div>
    </div>

    <div class="cheat-grid">
      <!-- Section 1: The Golden Rule -->
      <section class="card cheat-card golden-card">
        <h2 class="cheat-card-title">🌟 The Golden Rule of Word Layout</h2>
        <p>
          Never press <kbd>Enter</kbd> repeatedly to move things down.
          Use <kbd>Ctrl</kbd> + <kbd>Enter</kbd> to jump to the next page cleanly.
        </p>
        <div class="shortcuts-row">
          <div class="shortcut-item">
            <kbd>Enter</kbd>
            <span>New paragraph (adds paragraph gap)</span>
          </div>
          <div class="shortcut-item">
            <kbd>Shift</kbd> + <kbd>Enter</kbd>
            <span>Gentle line break (no extra gap)</span>
          </div>
          <div class="shortcut-item">
            <kbd>Ctrl</kbd> + <kbd>Enter</kbd>
            <span>Clean Page Break (jumps to next page)</span>
          </div>
        </div>
      </section>

      <!-- Section 2: Text Wrapping Quick Guide -->
      <section class="card cheat-card">
        <h2 class="cheat-card-title">📦 Text Wrap: Which One to Choose?</h2>
        <ul class="cheat-list">
          <li>
            <strong>In Line with Text:</strong> Word's tricky default. Acts like a giant typed letter. Hard to move around.
          </li>
          <li>
            <strong>Square:</strong> <em>Best for photos with text.</em> Text wraps neatly around the rectangular edge.
          </li>
          <li>
            <strong>Tight:</strong> Text hugs the actual contours of the picture or shape.
          </li>
          <li>
            <strong>Top and Bottom:</strong> Text stops above the photo and resumes below it (no text at the sides).
          </li>
          <li>
            <strong>In Front of Text:</strong> <em>Publisher-style freedom.</em> Floats over everything; drag it anywhere freely.
          </li>
        </ul>
      </section>

      <!-- Section 3: Anchors & Positioning -->
      <section class="card cheat-card">
        <h2 class="cheat-card-title">⚓ Move with Text vs. Fix on Page</h2>
        <ul class="cheat-list">
          <li>
            <strong>Move with text:</strong> The picture travels with its paragraph. Good for photos accompanying specific text.
          </li>
          <li>
            <strong>Fix position on page:</strong> The picture stays pinned to that spot on the page, but still travels if its anchor paragraph moves onto another page. Drag the blue anchor (⚓) to an earlier paragraph if this happens.
          </li>
          <li>
            <strong>Where to change it:</strong> Click the floating arch icon beside the picture → choose <em>Fix position on page</em>.
          </li>
        </ul>
      </section>

      <!-- Section 4: Text Box Rescue -->
      <section class="card cheat-card">
        <h2 class="cheat-card-title">✏️ Text Box Quick Setup</h2>
        <ol class="cheat-steps">
          <li>Insert → Text Box → <strong>Draw Text Box</strong>.</li>
          <li>Remove black border: Shape Format → Shape Outline → <strong>No Outline</strong>.</li>
          <li>Make transparent: Shape Format → Shape Fill → <strong>No Fill</strong>.</li>
          <li>Adjust inside margins: Right-click box border → <strong>Format Shape</strong> → Text Options → Text Box icon.</li>
        </ol>
      </section>

      <!-- Section 5: Troubleshooting Top 3 -->
      <section class="card cheat-card">
        <h2 class="cheat-card-title">🚨 Instant Troubleshooting</h2>
        <ul class="cheat-list">
          <li>
            <strong>Ribbon tabs missing?</strong> Click directly on the picture or text box border to bring them back.
          </li>
          <li>
            <strong>Can't group items?</strong> Make sure none of them are set to "In Line with Text".
          </li>
          <li>
            <strong>Picture trapped behind text?</strong> Home tab → Select (far right) → <strong>Selection Pane</strong>.
          </li>
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .cheat-main {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-4);
    padding-block: var(--space-8);
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-block-end: var(--space-8);
    padding-block-end: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (max-width: 640px) {
    .page-header {
      flex-direction: column;
    }
  }

  .lead {
    font-size: var(--font-size-lg);
    color: var(--ink-secondary);
    margin: 0;
  }

  .cheat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--space-6);
  }

  .cheat-card {
    display: flex;
    flex-direction: column;
  }

  .golden-card {
    grid-column: 1 / -1;
    background-color: var(--accent-publisher-bg);
    border-color: var(--accent-publisher-border);
    border-inline-start: 4px solid var(--accent-publisher);
  }

  .cheat-card-title {
    font-size: var(--font-size-xl);
    margin-block: 0 var(--space-3);
  }

  .shortcuts-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-3);
    margin-block-start: var(--space-3);
  }

  .shortcut-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    background-color: var(--surface-card);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .shortcut-item span {
    font-size: var(--font-size-sm);
    color: var(--ink-secondary);
  }

  .cheat-list,
  .cheat-steps {
    padding-inline-start: var(--space-5);
    margin: 0;
    font-size: var(--font-size-sm);
  }

  .cheat-list li,
  .cheat-steps li {
    margin-block-end: var(--space-2);
    line-height: 1.45;
  }
</style>
