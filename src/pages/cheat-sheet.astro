---
import BaseLayout from "../layouts/BaseLayout.astro";

const WRAP_STYLES = [
  {
    name: "In Line with Text",
    badge: "Word Default",
    usage: "Acts like a single giant typed letter. Moves wherever surrounding text pushes it. Hard to position freely.",
    iconId: "wrap-inline"
  },
  {
    name: "Square",
    badge: "Best for Photos",
    usage: "Text flows neatly around a rectangular boundary. Maintains a clean, professional margin around pictures.",
    iconId: "wrap-square"
  },
  {
    name: "Tight",
    badge: "Contour Wrap",
    usage: "Text contours tightly to the transparent edges of irregular illustrations, circles, or cut-out graphics.",
    iconId: "wrap-tight"
  },
  {
    name: "Through",
    badge: "Interior Wrap",
    usage: "Similar to Tight, but allows body text to flow inside hollow spaces or concave curves of transparent artwork.",
    iconId: "wrap-through"
  },
  {
    name: "Top and Bottom",
    badge: "Full Columns",
    usage: "Text stops above the graphic and resumes below it. Leaves left and right sides completely clear.",
    iconId: "wrap-topbottom"
  },
  {
    name: "Behind Text",
    badge: "Watermark Mode",
    usage: "Text prints directly over the graphic. Caution: clicking the graphic is difficult—use Selection Pane to select.",
    iconId: "wrap-behind"
  },
  {
    name: "In Front of Text",
    badge: "Publisher Canvas",
    usage: "Floats completely unconstrained over text. Drag it anywhere without displacing surrounding paragraphs.",
    iconId: "wrap-front"
  }
];

const DIRECTORY_ITEMS = [
  {
    publisher: "Insert picture from disk",
    wordLocation: "Insert tab → Pictures → This Device",
    shortcut: "Alt+N, P"
  },
  {
    publisher: "Change text wrapping",
    wordLocation: "Click object → floating arch icon beside corner → choose wrap",
    shortcut: "Picture Format → Wrap Text"
  },
  {
    publisher: "Object layering / Bring to Front",
    wordLocation: "Home tab → Select (far right) → Selection Pane",
    shortcut: "Alt+H, S, L"
  },
  {
    publisher: "Align and distribute objects",
    wordLocation: "Shape Format (or Picture Format) → Align → Align Center / Distribute",
    shortcut: "Alt+J, P, A, A"
  },
  {
    publisher: "Draw transparent text box",
    wordLocation: "Insert → Text Box → Draw Text Box (set Shape Fill: None, Outline: None)",
    shortcut: "Alt+N, X, D"
  },
  {
    publisher: "Link text frames for story overflow",
    wordLocation: "Select Box 1 → Shape Format tab → Create Link → Click Box 2",
    shortcut: "Alt+J, D, K"
  },
  {
    publisher: "Page border inside printable area",
    wordLocation: "Design tab → Page Borders → Options... → Measure from: Text",
    shortcut: "Alt+G, P, B"
  },
  {
    publisher: "Multi-column article with banner",
    wordLocation: "Layout tab → Breaks → Continuous, then Layout → Columns → Two",
    shortcut: "Alt+P, B, O"
  },
  {
    publisher: "Folded 4-page booklet",
    wordLocation: "Layout → Page Setup launcher (arrow) → Multiple pages: Book fold",
    shortcut: "Alt+P, S, P"
  },
  {
    publisher: "Export crisp press-ready PDF",
    wordLocation: "File → Export → Create PDF/XPS Document → Publish",
    shortcut: "F12 → Save as PDF"
  }
];

const EMERGENCY_FIXES = [
  {
    snag: "Picture jumped to the next page",
    fix: "Click floating arch icon beside photo → choose 'Fix position on page'. If anchor paragraph moved, drag anchor (⚓) up."
  },
  {
    snag: "Format tab disappeared from Ribbon",
    fix: "Click directly on the border or body of the picture or text box to reactivate the contextual tab."
  },
  {
    snag: "'Group' button is greyed out",
    fix: "Select each item individually and change wrap from 'In Line with Text' to 'Square'. Then multi-select with Shift."
  },
  {
    snag: "Picture stuck behind text layer",
    fix: "Go to Home tab → Select → Selection Pane. Click the picture name in the list to select and bring forward."
  },
  {
    snag: "Page border cuts off at bottom",
    fix: "Design → Page Borders → Options... → Change 'Measure from: Edge of page' to 'Measure from: Text'."
  },
  {
    snag: "Stubborn blank page at end of doc",
    fix: "Turn on Show/Hide ¶ (Ctrl+Shift+8). Highlight lone ¶ mark on blank page, set Font Size to 1 pt, line spacing to 1.0."
  }
];
---

<BaseLayout title="Printable Desk Cheat Sheets">
  <main id="content" class="page-main cheat-main" tabindex="-1">
    <div class="page-header">
      <div class="header-left">
        <span class="badge badge-ribbon">Desk Reference</span>
        <h1>Word Layout Desk Reference Cheat Sheets</h1>
        <p class="lead">
          Print these 2 pages out and keep them beside your keyboard for instant clarity when laying out flyers, notices, booklets, and newsletters.
        </p>
      </div>
      <div class="header-right">
        <button type="button" class="btn btn-primary print-action-btn" data-print-trigger>
          <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5 2.75C5 2.06 5.56 1.5 6.25 1.5h7.5c.69 0 1.25.56 1.25 1.25v2.5H5v-2.5zm-1.5 4h13A2.25 2.25 0 0118.75 9v5A2.25 2.25 0 0116.5 16.25h-1.5V17c0 .69-.56 1.25-1.25 1.25H6.25A1.25 1.25 0 015 17v-.75H3.5A2.25 2.25 0 011.25 14V9A2.25 2.25 0 013.5 6.75zm3 6h7a.75.75 0 00.75-.75V10.5a.75.75 0 00-.75-.75h-7a.75.75 0 00-.75.75v1.5c0 .414.336.75.75.75z" clip-rule="evenodd"/>
          </svg>
          <span>Print Both Sheets</span>
        </button>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- SHEET 1: Wrap, Anchor & Spacing Guide -->
    <!-- ========================================== -->
    <article class="sheet-container cheat-sheet-page" id="sheet-1">
      <header class="sheet-header">
        <div class="sheet-title-row">
          <span class="sheet-badge">Sheet 1 of 2</span>
          <h2 class="sheet-title">Word Layout Guide: Wrap, Anchors & Spacing</h2>
        </div>
        <p class="sheet-subtitle">Keep text flowing smoothly around pictures and stop unwanted page jumps</p>
      </header>

      <div class="sheet-grid">
        <!-- Section: The 3 Enter Keys -->
        <section class="card sheet-card golden-card">
          <h3 class="card-title">🌟 The Three Ways to Move Down</h3>
          <p class="card-intro">Never press Enter repeatedly to position things down a page! Use the right key combination:</p>
          <div class="enter-keys-grid">
            <div class="key-item">
              <kbd class="key-badge">Enter</kbd>
              <div class="key-desc">
                <strong>New Paragraph</strong>
                <span>Starts a new paragraph with full paragraph-after spacing.</span>
              </div>
            </div>
            <div class="key-item">
              <kbd class="key-badge">Shift + Enter</kbd>
              <div class="key-desc">
                <strong>Soft Line Break</strong>
                <span>Drops to the next line without any extra paragraph gap.</span>
              </div>
            </div>
            <div class="key-item">
              <kbd class="key-badge">Ctrl + Enter</kbd>
              <div class="key-desc">
                <strong>Clean Page Break</strong>
                <span>Jumps immediately to the top of the next page cleanly.</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Section: The 7 Text Wrapping Styles -->
        <section class="card sheet-card wrap-section">
          <h3 class="card-title">📦 Which Text Wrap Style Should You Pick?</h3>
          <div class="wrap-grid">
            {WRAP_STYLES.map(style => (
              <div class="wrap-card">
                <div class="wrap-card-header">
                  <span class="wrap-icon" aria-hidden="true">
                    {style.iconId === "wrap-inline" && "📝"}
                    {style.iconId === "wrap-square" && "🔲"}
                    {style.iconId === "wrap-tight" && "🔷"}
                    {style.iconId === "wrap-through" && "⭕"}
                    {style.iconId === "wrap-topbottom" && "⏸️"}
                    {style.iconId === "wrap-behind" && "📄"}
                    {style.iconId === "wrap-front" && "🎨"}
                  </span>
                  <div>
                    <h4 class="wrap-name">{style.name}</h4>
                    <span class="badge badge-contextual wrap-badge">{style.badge}</span>
                  </div>
                </div>
                <p class="wrap-usage">{style.usage}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Section: Anchors & Positioning -->
        <section class="card sheet-card anchors-section">
          <h3 class="card-title">⚓ Anchors & Positioning: Stop the Jumping</h3>
          <div class="anchors-two-col">
            <div class="anchor-col">
              <h4>Move with Text</h4>
              <p>The picture travels vertically whenever paragraphs above it are added or removed. Best for inline illustrations that explain a specific sentence.</p>
            </div>
            <div class="anchor-col">
              <h4>Fix Position on Page</h4>
              <p>The picture remains locked at its exact (x, y) coordinates on the printed page. Text flows freely around it. If text pushes its anchor mark across a page boundary, drag the ⚓ icon back up.</p>
            </div>
          </div>
          <div class="anchor-tip">
            <strong>Key Habit:</strong> Always turn on <strong>Show/Hide ¶</strong> (<kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>8</kbd>) to reveal the anchor icon (⚓) in the left margin.
          </div>
        </section>

        <!-- Section: Clean Text Box Setup -->
        <section class="card sheet-card textbox-section">
          <h3 class="card-title">✏️ The 4-Step Clean Text Box</h3>
          <ol class="numbered-list">
            <li><strong>Draw:</strong> Insert → Text Box → <em>Draw Text Box</em> (never use pre-templated sidebar boxes).</li>
            <li><strong>Clear Outline:</strong> Shape Format → Shape Outline → choose <strong>No Outline</strong>.</li>
            <li><strong>Clear Fill:</strong> Shape Format → Shape Fill → choose <strong>No Fill</strong> (makes container transparent).</li>
            <li><strong>Pad Margins:</strong> Right-click box → Format Shape → Text Options → Text Box → set margins to 0.2 cm.</li>
          </ol>
        </section>
      </div>
    </article>

    <!-- ========================================== -->
    <!-- SHEET 2: Directory & Instant Rescue Card -->
    <!-- ========================================== -->
    <article class="sheet-container cheat-sheet-page" id="sheet-2">
      <header class="sheet-header">
        <div class="sheet-title-row">
          <span class="sheet-badge">Sheet 2 of 2</span>
          <h2 class="sheet-title">Word Layout Guide: Directory & Emergency Rescue</h2>
        </div>
        <p class="sheet-subtitle">Two-column lookup directory for Publisher habits, plus top 6 immediate fixes</p>
      </header>

      <div class="sheet-grid">
        <!-- Section: "Where Do I Find...?" Directory Table -->
        <section class="card sheet-card directory-section">
          <h3 class="card-title">🔍 "Where Did That Button Go?" Quick Directory</h3>
          <div class="table-container">
            <table class="cheat-table">
              <thead>
                <tr>
                  <th scope="col" class="th-pub">In Publisher I Did This...</th>
                  <th scope="col" class="th-word">In Microsoft Word, Go To...</th>
                  <th scope="col" class="th-key">Shortcut / Quick Path</th>
                </tr>
              </thead>
              <tbody>
                {DIRECTORY_ITEMS.map(item => (
                  <tr>
                    <td class="td-pub"><strong>{item.publisher}</strong></td>
                    <td class="td-word">{item.wordLocation}</td>
                    <td class="td-key"><kbd class="table-kbd">{item.shortcut}</kbd></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Section: Instant Rescue Top 6 -->
        <section class="card sheet-card rescue-section">
          <h3 class="card-title">🚨 Instant Troubleshooting: The Top 6 Snags</h3>
          <div class="emergency-grid">
            {EMERGENCY_FIXES.map(item => (
              <div class="emergency-card">
                <h4 class="emergency-snag">⚠️ {item.snag}</h4>
                <p class="emergency-fix"><strong>Fix:</strong> {item.fix}</p>
              </div>
            ))}
          </div>
        </section>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-block-end: var(--space-8);
    padding-block-end: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (max-width: 640px) {
    .page-header {
      flex-direction: column;
    }
  }

  .lead {
    font-size: var(--font-size-lg);
    color: var(--ink-secondary);
    line-height: var(--line-height-relaxed);
    max-inline-size: 68ch;
    margin-block-start: var(--space-2);
  }

  .print-action-btn {
    white-space: nowrap;
    padding-inline: var(--space-4);
  }

  /* Sheet Container Layout */
  .sheet-container {
    background-color: var(--surface-card);
    border: 2px solid var(--border-ui);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-block-end: var(--space-10);
    box-shadow: 0 2px 6px 0 rgb(0 0 0 / 4%);
  }

  .sheet-header {
    border-bottom: 2px solid var(--accent-word);
    padding-block-end: var(--space-4);
    margin-block-end: var(--space-6);
  }

  .sheet-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .sheet-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--accent-word);
    color: #ffffff;
  }

  .sheet-title {
    font-size: var(--font-size-xl);
    color: var(--ink-primary);
    margin: 0;
  }

  .sheet-subtitle {
    font-size: var(--font-size-sm);
    color: var(--ink-secondary);
    margin-block: var(--space-1) 0;
  }

  .sheet-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .sheet-card {
    background-color: var(--surface-ground);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .card-title {
    font-size: var(--font-size-lg);
    color: var(--ink-primary);
    margin: 0;
    margin-block-end: var(--space-3);
  }

  .card-intro {
    font-size: var(--font-size-sm);
    color: var(--ink-secondary);
    margin: 0;
    margin-block-end: var(--space-3);
  }

  /* Golden Rule & Keys */
  .golden-card {
    background-color: var(--accent-tip-bg);
    border-color: var(--accent-tip-border);
    border-inline-start: 4px solid var(--accent-tip);
  }

  .enter-keys-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-3);
  }

  .key-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background-color: var(--surface-card);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .key-badge {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-ui);
    box-shadow: 0 1px 1px rgb(0 0 0 / 10%);
    white-space: nowrap;
    color: var(--ink-primary);
    flex-shrink: 0;
  }

  .key-desc {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-inline-size: 0;
    overflow-wrap: break-word;
  }

  .key-desc strong {
    font-size: var(--font-size-sm);
    color: var(--ink-primary);
  }

  .key-desc span {
    font-size: var(--font-size-xs);
    color: var(--ink-secondary);
    line-height: var(--line-height-normal);
  }

  /* Wrap Styles Grid */
  .wrap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-3);
  }

  .wrap-card {
    background-color: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .wrap-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .wrap-icon {
    font-size: 1.25rem;
    line-height: 1;
  }

  .wrap-name {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--ink-primary);
    margin: 0;
  }

  .wrap-badge {
    font-size: 0.65rem;
    padding: 0.1rem 0.35rem;
  }

  .wrap-usage {
    font-size: var(--font-size-xs);
    color: var(--ink-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  /* Anchors Section */
  .anchors-two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    margin-block-end: var(--space-3);
  }

  .anchor-col h4 {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--accent-word);
    margin: 0;
    margin-block-end: var(--space-1);
  }

  .anchor-col p {
    font-size: var(--font-size-xs);
    color: var(--ink-primary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  .anchor-tip {
    font-size: var(--font-size-xs);
    background-color: var(--surface-card);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    border-inline-start: 3px solid var(--accent-word);
    color: var(--ink-primary);
  }

  /* Numbered List */
  .numbered-list {
    margin: 0;
    padding-inline-start: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    line-height: var(--line-height-relaxed);
    color: var(--ink-primary);
  }

  /* Directory Table */
  .table-container {
    overflow-x: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .cheat-table {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-xs);
    background-color: var(--surface-card);
  }

  .cheat-table th,
  .cheat-table td {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-subtle);
    text-align: start;
    vertical-align: middle;
  }

  .cheat-table th {
    background-color: var(--surface-subtle);
    color: var(--ink-primary);
    font-weight: 700;
  }

  .td-pub {
    color: var(--accent-word);
    white-space: nowrap;
  }

  .td-word {
    color: var(--ink-primary);
    line-height: var(--line-height-normal);
  }

  .table-kbd {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.15rem 0.35rem;
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  /* Emergency Snags */
  .emergency-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-3);
  }

  .emergency-card {
    background-color: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
  }

  .emergency-snag {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--ink-primary);
    margin: 0;
    margin-block-end: var(--space-1);
  }

  .emergency-fix {
    font-size: var(--font-size-xs);
    color: var(--ink-secondary);
    line-height: var(--line-height-normal);
    margin: 0;
  }

  @media (forced-colors: active) {
    .sheet-container {
      border: 2px solid ButtonText !important;
    }

    .sheet-card {
      border: 1px solid ButtonText !important;
    }

    .key-badge {
      border: 1px solid ButtonText !important;
    }
  }
</style>
