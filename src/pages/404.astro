---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found (404)">
  <main id="content" class="not-found-main" tabindex="-1">
    <div class="card not-found-card">
      <span class="badge badge-ribbon">404 Error</span>
      <h1 class="not-found-title">Page Not Found</h1>
      <p class="not-found-desc">
        We could not find the page you were looking for. It might have moved, or the web address might have been mistyped.
      </p>

      <div class="recovery-links">
        <h2 class="recovery-heading">Helpful places to start:</h2>
        <ul class="recovery-list">
          <li>
            <a href="/" class="recovery-link">
              <strong>Home</strong>
              <span>An overview of Publisher vs. Word mental models</span>
            </a>
          </li>
          <li>
            <a href="/start-here" class="recovery-link">
              <strong>Start Here</strong>
              <span>The 5-minute orientation and 3 switches to turn on in Word</span>
            </a>
          </li>
          <li>
            <a href="/lessons" class="recovery-link">
              <strong>All Lessons</strong>
              <span>Browse the full 14-lesson layout curriculum</span>
            </a>
          </li>
          <li>
            <a href="/rescue" class="recovery-link">
              <strong>Rescue Guide</strong>
              <span>Immediate fixes for when objects or ribbon tabs misbehave</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="not-found-actions">
        <a href="/" class="btn btn-primary">
          <span>Go to Home Page</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found-main {
    width: 100%;
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: var(--space-4);
    padding-block: var(--space-10);
  }

  .not-found-card {
    padding: var(--space-8);
  }

  .not-found-title {
    font-size: var(--font-size-3xl);
    margin-block: var(--space-3) var(--space-4);
  }

  .not-found-desc {
    color: var(--ink-secondary);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-normal);
    margin-block-end: var(--space-6);
  }

  .recovery-links {
    border-top: 1px solid var(--border-subtle);
    padding-block-start: var(--space-6);
    margin-block-end: var(--space-6);
  }

  .recovery-heading {
    font-size: var(--font-size-base);
    color: var(--ink-primary);
    margin-block-end: var(--space-4);
  }

  .recovery-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .recovery-link {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink-secondary);
    min-block-size: var(--target-min-size);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .recovery-link strong {
    color: var(--accent-word);
    font-size: var(--font-size-base);
  }

  .recovery-link span {
    font-size: var(--font-size-sm);
  }

  .recovery-link:hover {
    border-color: var(--accent-word);
    background-color: var(--surface-subtle);
  }

  .not-found-actions {
    display: flex;
    gap: var(--space-3);
  }
</style>
