---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getCurriculum } from "../../data/curriculum";

const authored = await getCollection("lessons");
const curriculum = getCurriculum(authored);
---

<BaseLayout title="All Lessons">
  <main id="content" class="page-main lessons-main" tabindex="-1">
    <div class="page-header">
      <div class="header-content">
        <span class="badge badge-ribbon">Full Curriculum</span>
        <h1>All 14 Lessons</h1>
        <p class="lead">
          Browse the complete step-by-step curriculum designed to guide you comfortably through Microsoft Word's layout concepts.
        </p>
      </div>

      <!-- Quick Module & Sandboxes Navigation -->
      <nav class="module-jump-nav" aria-label="Jump to module">
        <span class="jump-nav-label">Jump to module:</span>
        <div class="jump-pills">
          {curriculum.map(mod => (
            <a href={`#module-${mod.number}`} class="jump-pill">
              <span class="pill-badge">Module {mod.number}</span>
              <span class="pill-title">{mod.title}</span>
            </a>
          ))}
          <a href="/sandboxes" class="jump-pill jump-sandboxes">
            <span aria-hidden="true">🎮</span>
            <span>Visual Sandboxes</span>
          </a>
        </div>
      </nav>
    </div>

    <!-- Interactive Sandboxes Invitation Banner -->
    <section class="card sandboxes-banner" aria-labelledby="sandboxes-banner-title">
      <div class="banner-inner">
        <div class="banner-text">
          <span class="badge badge-contextual">Hands-On Practice</span>
          <h2 id="sandboxes-banner-title" class="sandboxes-banner-title">Interactive Layout Sandboxes</h2>
          <p class="sandboxes-banner-desc">
            Prefer learning by doing? Practise with Word's core positioning mechanics in real time. Experiment with wrapping, object anchors, text box margins, and precision alignment.
          </p>
        </div>
        <div class="banner-action">
          <a href="/sandboxes" class="btn btn-secondary banner-btn">
            <span>Open All 4 Sandboxes</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Curriculum Modules -->
    <div class="modules-stack">
      {curriculum.map(mod => (
        <section class="card module-section" id={`module-${mod.number}`}>
          <div class="module-header">
            <span class="badge badge-ribbon">Module {mod.number}</span>
            <h2 class="module-title">{mod.title}</h2>
            <p class="module-summary">{mod.summary}</p>
          </div>

          <ol class="lesson-cards-list">
            {mod.lessons.map(lesson => (
              <li class="lesson-item">
                {lesson.isAvailable ? (
                  <a href={`/lessons/${lesson.slug}`} class="lesson-card-link">
                    <div class="lesson-card-top">
                      <span class="lesson-number">Lesson {lesson.order}</span>
                      <span class="lesson-status available">Ready to Learn</span>
                    </div>
                    <h3 class="lesson-heading">{lesson.title}</h3>
                    <p class="lesson-card-desc">{lesson.summary}</p>
                  </a>
                ) : (
                  <div class="lesson-card-upcoming">
                    <div class="lesson-card-top">
                      <span class="lesson-number">Lesson {lesson.order}</span>
                      <span class="lesson-status upcoming">Coming in Phase 3</span>
                    </div>
                    <h3 class="lesson-heading">{lesson.title}</h3>
                    <p class="lesson-card-desc">{lesson.summary}</p>
                  </div>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .lessons-main {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-4);
    padding-block: var(--space-8);
  }

  .page-header {
    margin-block-end: var(--space-8);
    padding-block-end: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .lead {
    font-size: var(--font-size-lg);
    color: var(--ink-secondary);
    max-inline-size: var(--max-prose-width);
  }

  .module-jump-nav {
    margin-block-start: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .jump-nav-label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-secondary);
  }

  .jump-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .jump-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--target-min-size);
    min-inline-size: var(--target-min-size);
    padding-inline: var(--space-3);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--ink-primary);
    background-color: var(--surface-card);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .jump-pill:hover {
    background-color: var(--accent-word-bg);
    border-color: var(--accent-word);
    color: var(--accent-word);
  }

  .pill-badge {
    font-size: var(--font-size-xs);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
    background-color: var(--surface-subtle);
    color: var(--ink-secondary);
    border: 1px solid var(--border-subtle);
  }

  .jump-pill.jump-sandboxes {
    background-color: var(--surface-subtle);
    border-color: var(--border-subtle);
    margin-inline-start: auto;
  }

  .jump-pill.jump-sandboxes:hover {
    background-color: var(--accent-word-bg);
    border-color: var(--accent-word);
    color: var(--accent-word);
  }

  @media (max-width: 640px) {
    .jump-pill.jump-sandboxes {
      margin-inline-start: 0;
    }
  }

  /* Sandboxes Invitation Banner */
  .sandboxes-banner {
    margin-block-end: var(--space-8);
    background-color: var(--accent-word-bg);
    border: 1px solid var(--accent-word-border);
  }

  .banner-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
  }

  @media (max-width: 768px) {
    .banner-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .sandboxes-banner-title {
    font-size: var(--font-size-xl);
    margin-block: var(--space-2) var(--space-1);
    color: var(--ink-primary);
  }

  .sandboxes-banner-desc {
    font-size: var(--font-size-base);
    color: var(--ink-secondary);
    margin: 0;
    max-inline-size: var(--max-prose-width);
  }

  .banner-btn {
    white-space: nowrap;
    background-color: #FFFFFF;
  }

  /* Modules Stack */
  .modules-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .module-section {
    padding: var(--space-6);
    scroll-margin-top: 5rem;
  }

  .module-header {
    margin-block-end: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
    padding-block-end: var(--space-4);
  }

  .module-title {
    font-size: var(--font-size-2xl);
    margin-block: var(--space-2) var(--space-1);
  }

  .module-summary {
    font-size: var(--font-size-base);
    color: var(--ink-secondary);
    margin: 0;
    max-inline-size: var(--max-prose-width);
  }

  .lesson-cards-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
  }

  .lesson-item {
    display: flex;
  }

  .lesson-card-link,
  .lesson-card-upcoming {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    background-color: var(--surface-card);
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .lesson-card-link:hover {
    border-color: var(--accent-word);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 10%);
  }

  .lesson-card-upcoming {
    opacity: 0.85;
    background-color: var(--surface-subtle);
  }

  .lesson-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-block-end: var(--space-2);
  }

  .lesson-number {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-secondary);
  }

  .lesson-status {
    font-size: 0.75rem;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .lesson-status.available {
    background-color: var(--accent-success-bg);
    color: var(--accent-success);
    border: 1px solid var(--accent-success-border);
  }

  .lesson-status.upcoming {
    background-color: var(--surface-subtle);
    color: var(--ink-secondary);
    border: 1px solid var(--border-subtle);
  }

  .lesson-heading {
    font-size: var(--font-size-lg);
    margin-block: 0 var(--space-2);
    color: var(--accent-word);
  }

  .lesson-card-upcoming .lesson-heading {
    color: var(--ink-secondary);
  }

  .lesson-card-desc {
    font-size: var(--font-size-sm);
    color: var(--ink-secondary);
    margin: 0;
    flex-grow: 1;
  }

  @media (forced-colors: active) {
    .jump-pill {
      border: 1px solid ButtonText !important;
    }
  }
</style>
