---
import BaseLayout from "../layouts/BaseLayout.astro";
import { TRANSLATOR_CATEGORIES, TRANSLATOR_ENTRIES } from "../data/translator";
---

<BaseLayout title="Publisher → Word Translator">
  <main id="content" class="page-main translator-main" tabindex="-1">
    <div class="page-header">
      <span class="badge badge-ribbon">Quick Lookup</span>
      <h1>Publisher → Word Translator</h1>
      <p class="lead">
        Find the exact Word feature for the Publisher tools, terms, and habits you already know by heart.
      </p>
    </div>

    <!-- Filter & Search Toolbar -->
    <section class="filter-section" aria-labelledby="filter-heading">
      <h2 id="filter-heading" class="visually-hidden">Filter Translations</h2>

      <div class="filter-toolbar">
        <div class="search-field">
          <label for="translator-search" class="search-label">
            <span class="search-icon" aria-hidden="true">🔍</span>
            <span>Search habits or features:</span>
          </label>
          <input
            type="search"
            id="translator-search"
            class="search-input"
            placeholder="Filter by term (e.g. scratch, border, anchor, crop)..."
            autocomplete="off"
            spellcheck="false"
          />
        </div>

        <div class="category-pills" role="radiogroup" aria-label="Filter by category">
          {TRANSLATOR_CATEGORIES.map(cat => (
            <button
              type="button"
              class:list={["pill-btn", { "is-active": cat.id === "all" }]}
              role="radio"
              aria-checked={cat.id === "all" ? "true" : "false"}
              tabindex={cat.id === "all" ? 0 : -1}
              data-category={cat.id}
            >
              <span>{cat.label}</span>
              <span class="pill-count" aria-hidden="true">
                {cat.id === "all"
                  ? TRANSLATOR_ENTRIES.length
                  : TRANSLATOR_ENTRIES.filter(e => e.category === cat.id).length}
              </span>
            </button>
          ))}
        </div>
      </div>

      <div class="filter-status" aria-live="polite" id="filter-status">
        Showing all {TRANSLATOR_ENTRIES.length} translations.
      </div>
    </section>

    <!-- Responsive Table Container -->
    <div
      tabindex="0"
      role="region"
      aria-labelledby="translator-table-caption"
      class="table-wrapper"
    >
      <table class="translator-table" id="translator-table">
        <caption id="translator-table-caption" class="visually-hidden">
          Comparison directory mapping Microsoft Publisher features to Microsoft Word equivalents with ribbon locations and lesson links.
        </caption>
        <thead>
          <tr>
            <th scope="col" class="col-head-pub">In Microsoft Publisher</th>
            <th scope="col" class="col-head-word">In Microsoft Word</th>
            <th scope="col" class="col-head-path">Where to Find It & Guide</th>
          </tr>
        </thead>
        <tbody>
          {TRANSLATOR_ENTRIES.map(item => (
            <tr
              class="translator-row"
              data-category={item.category}
              data-id={item.id}
            >
              <th scope="row" class="col-publisher">
                <span class="pub-title">{item.publisher}</span>
              </th>
              <td class="col-word" data-label="In Microsoft Word">
                <p class="word-desc">{item.word}</p>
                <div class="tip-inline">
                  <span class="tip-icon" aria-hidden="true">💡</span>
                  <span>{item.tip}</span>
                </div>
              </td>
              <td class="col-path" data-label="Where to Find It & Guide">
                <div class="path-details">
                  <div class="path-badges">
                    <span class="badge badge-contextual">{item.ribbonPath}</span>
                    {item.altPath && (
                      <span class="badge badge-alt">{item.altPath}</span>
                    )}
                  </div>
                  <a
                    href={`/lessons/${item.lessonSlug}`}
                    class="lesson-link"
                    aria-label={`Read ${item.lessonTitle} for ${item.publisher}`}
                  >
                    <span>{item.lessonTitle}</span>
                    <span class="link-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <!-- Empty State when filter yields 0 matches -->
      <div id="translator-empty" class="card empty-state" hidden>
        <span class="empty-icon" aria-hidden="true">🔎</span>
        <h3 class="empty-title">No matching translations found</h3>
        <p class="empty-desc">
          We could not find any Publisher term or Word tool matching your current filter.
        </p>
        <button type="button" class="btn btn-primary" id="reset-filters-btn">
          <span>Reset All Filters</span>
          <span aria-hidden="true">↺</span>
        </button>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { filterTranslatorEntries } from "../utils/reference";
  import { TRANSLATOR_ENTRIES } from "../data/translator";
  import type { TranslatorCategory } from "../data/translator";

  const searchInput = document.getElementById("translator-search") as HTMLInputElement | null;
  const pillBtns = document.querySelectorAll<HTMLButtonElement>(".category-pills .pill-btn");
  const table = document.getElementById("translator-table") as HTMLTableElement | null;
  const rows = document.querySelectorAll<HTMLTableRowElement>(".translator-row");
  const emptyState = document.getElementById("translator-empty");
  const filterStatus = document.getElementById("filter-status");
  const resetBtn = document.getElementById("reset-filters-btn");

  let currentCategory: TranslatorCategory = "all";
  let currentQuery = "";

  function applyFilter() {
    const matchedEntries = filterTranslatorEntries(
      TRANSLATOR_ENTRIES,
      currentQuery,
      currentCategory
    );
    const matchedIds = new Set(matchedEntries.map(e => e.id));

    let visibleCount = 0;
    rows.forEach(row => {
      const id = row.getAttribute("data-id") || "";
      const isVisible = matchedIds.has(id);
      row.hidden = !isVisible;
      if (isVisible) visibleCount++;
    });

    if (table) {
      table.style.display = visibleCount === 0 ? "none" : "";
    }
    if (emptyState) {
      emptyState.hidden = visibleCount > 0;
    }

    if (filterStatus) {
      if (visibleCount === TRANSLATOR_ENTRIES.length) {
        filterStatus.textContent = `Showing all ${TRANSLATOR_ENTRIES.length} translations.`;
      } else if (visibleCount === 0) {
        filterStatus.textContent = "No translations found matching your search.";
      } else {
        filterStatus.textContent = `Showing ${visibleCount} of ${TRANSLATOR_ENTRIES.length} translations.`;
      }
    }
  }

  searchInput?.addEventListener("input", () => {
    currentQuery = searchInput.value;
    applyFilter();
  });

  pillBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      const cat = (btn.getAttribute("data-category") || "all") as TranslatorCategory;
      currentCategory = cat;

      pillBtns.forEach(b => {
        const isActive = b === btn;
        b.classList.toggle("is-active", isActive);
        b.setAttribute("aria-checked", isActive ? "true" : "false");
        b.setAttribute("tabindex", isActive ? "0" : "-1");
      });

      applyFilter();
    });
  });

  // WAI-ARIA Radio Group keyboard navigation
  const pillsContainer = document.querySelector(".category-pills");
  if (pillsContainer) {
    pillsContainer.addEventListener("keydown", (e: Event) => {
      const keyEvent = e as KeyboardEvent;
      const pills = Array.from(pillBtns);
      const currentIndex = pills.findIndex(btn => btn.getAttribute("tabindex") === "0");
      if (currentIndex === -1) return;

      let nextIndex = -1;
      if (keyEvent.key === "ArrowRight" || keyEvent.key === "ArrowDown") {
        keyEvent.preventDefault();
        nextIndex = (currentIndex + 1) % pills.length;
      } else if (keyEvent.key === "ArrowLeft" || keyEvent.key === "ArrowUp") {
        keyEvent.preventDefault();
        nextIndex = (currentIndex - 1 + pills.length) % pills.length;
      } else if (keyEvent.key === "Home") {
        keyEvent.preventDefault();
        nextIndex = 0;
      } else if (keyEvent.key === "End") {
        keyEvent.preventDefault();
        nextIndex = pills.length - 1;
      }

      if (nextIndex !== -1) {
        const nextPill = pills[nextIndex];
        nextPill.click();
        nextPill.focus();
      }
    });
  }

  resetBtn?.addEventListener("click", () => {
    if (searchInput) {
      searchInput.value = "";
      currentQuery = "";
    }
    currentCategory = "all";

    pillBtns.forEach(b => {
      const isAll = b.getAttribute("data-category") === "all";
      b.classList.toggle("is-active", isAll);
      b.setAttribute("aria-checked", isAll ? "true" : "false");
      b.setAttribute("tabindex", isAll ? "0" : "-1");
    });

    applyFilter();
    searchInput?.focus();
  });
</script>

<style>
  .page-header {
    margin-block-end: var(--space-6);
    padding-block-end: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .lead {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-normal);
    color: var(--ink-secondary);
  }

  /* Filter Toolbar */
  .filter-section {
    margin-block-end: var(--space-6);
  }

  .filter-toolbar {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background-color: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 2%);
  }

  .search-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .search-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    font-size: var(--font-size-sm);
    color: var(--ink-primary);
  }

  .search-input {
    width: 100%;
    min-block-size: var(--target-min-size);
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-base);
    font-family: inherit;
    color: var(--ink-primary);
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-md);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .search-input:focus-visible {
    outline: none;
    border-color: var(--accent-word);
    box-shadow: 0 0 0 3px var(--accent-word-bg);
  }

  .category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pill-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--target-min-size);
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-size-sm);
    font-weight: 600;
    font-family: inherit;
    color: var(--ink-secondary);
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .pill-btn:hover {
    background-color: var(--surface-hover);
    color: var(--ink-primary);
    border-color: var(--border-ui);
  }

  .pill-btn.is-active {
    background-color: var(--accent-word-bg);
    color: var(--accent-word);
    border-color: var(--accent-word);
  }

  .pill-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-2);
    font-size: var(--font-size-xs);
    border-radius: var(--radius-pill);
    background-color: rgb(0 0 0 / 6%);
    color: inherit;
  }

  .filter-status {
    margin-block-start: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--ink-secondary);
  }

  /* Table Wrapper & Responsive Container */
  .table-wrapper {
    overflow: auto;
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-lg);
    background-color: var(--surface-card);
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 4%);
    container-type: inline-size;
  }

  .translator-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    text-align: start;
    font-size: var(--font-size-base);
  }

  .translator-table thead {
    position: sticky;
    inset-block-start: 0;
    z-index: 2;
  }

  .translator-table th[scope="col"] {
    background-color: var(--surface-subtle);
    padding: var(--space-4);
    border-bottom: 2px solid var(--border-ui);
    color: var(--ink-primary);
    font-weight: 700;
    text-align: start;
    white-space: nowrap;
  }

  .col-head-pub {
    width: 28%;
  }

  .col-head-word {
    width: 44%;
  }

  .col-head-path {
    width: 28%;
  }

  .translator-row td,
  .translator-row th[scope="row"] {
    padding: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: top;
  }

  .translator-row:last-child td,
  .translator-row:last-child th[scope="row"] {
    border-bottom: none;
  }

  .col-publisher {
    color: var(--accent-publisher);
    font-size: var(--font-size-base);
    font-weight: 700;
    text-align: start;
  }

  .pub-title {
    display: inline-block;
  }

  .word-desc {
    color: var(--ink-primary);
    margin: 0;
    margin-block-end: var(--space-2);
    line-height: var(--line-height-normal);
  }

  .tip-inline {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--ink-secondary);
    background-color: var(--surface-subtle);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--accent-publisher);
    line-height: var(--line-height-normal);
  }

  .tip-icon {
    flex-shrink: 0;
  }

  .path-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .path-badges {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .badge-alt {
    background-color: var(--surface-subtle);
    color: var(--ink-secondary);
    border: 1px solid var(--border-subtle);
    font-size: var(--font-size-xs);
    font-weight: 500;
  }

  .lesson-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--accent-word);
    text-decoration: none;
    min-block-size: var(--target-min-size);
  }

  .lesson-link:hover {
    text-decoration: underline;
  }

  .link-arrow {
    transition: transform 0.15s ease;
  }

  .lesson-link:hover .link-arrow {
    transform: translateX(3px);
  }

  .translator-row[hidden],
  .empty-state[hidden] {
    display: none !important;
  }

  /* Empty State */
  .empty-state {
    padding: var(--space-8) var(--space-4);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .empty-icon {
    font-size: 2.5rem;
  }

  .empty-title {
    font-size: var(--font-size-xl);
    color: var(--ink-primary);
    margin: 0;
  }

  .empty-desc {
    color: var(--ink-secondary);
    max-inline-size: 32rem;
    margin: 0;
  }

  /* Container Query: Stacked Card Layout on Narrow Viewports (responsive-table guidance) */
  @container (width < 46rem) {
    .translator-table thead {
      display: none;
    }

    .translator-table,
    .translator-table tbody,
    .translator-row,
    .translator-row th[scope="row"],
    .translator-row td {
      display: block;
      width: 100%;
    }

    .translator-row {
      margin-block-end: var(--space-4);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      overflow: hidden;
      background-color: var(--surface-card);
      box-shadow: 0 1px 2px 0 rgb(0 0 0 / 2%);
    }

    .translator-row th[scope="row"].col-publisher {
      position: sticky;
      inset-block-start: 0;
      z-index: 1;
      background-color: var(--surface-subtle);
      border-bottom: 2px solid var(--accent-publisher);
      padding: var(--space-3) var(--space-4);
      font-size: var(--font-size-base);
    }

    .translator-row td {
      padding: var(--space-3) var(--space-4);
      border-bottom: 1px solid var(--border-subtle);
    }

    .translator-row td:last-child {
      border-bottom: none;
    }

    .translator-row td::before {
      content: attr(data-label);
      display: block;
      font-size: var(--font-size-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ink-secondary);
      margin-block-end: var(--space-1);
    }
  }

  /* Print Stylesheet Overrides */
  @media print {
    .filter-section {
      display: none !important;
    }

    .table-wrapper {
      border: none;
      box-shadow: none;
      overflow: visible;
    }

    .translator-table th[scope="col"] {
      background-color: #F1F5F9 !important;
      color: #000000 !important;
    }

    .translator-row {
      break-inside: avoid;
    }
  }
</style>
