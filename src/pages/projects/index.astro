---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Guided Layout Projects">
  <main id="content" class="page-main projects-main" tabindex="-1">
    <div class="page-header">
      <span class="badge badge-ribbon">Hands-On Practice</span>
      <h1>Guided Layout Projects</h1>
      <p class="lead">
        Build confidence with realistic, step-by-step document templates. Each project takes you from a blank Word document to a finished, print-ready publication with zero guesswork.
      </p>
    </div>

    <div class="projects-grid">
      {projects.map(proj => {
        const slug = proj.id.replace(/\.mdx?$/, "");
        return (
          <article class="card project-card">
            <div class="project-header">
              <div class="project-badges">
                <span class="badge badge-contextual">{proj.data.duration}</span>
                <span class="badge badge-alt">{proj.data.format}</span>
              </div>
              <h2 class="project-title">{proj.data.title}</h2>
            </div>

            <p class="project-summary">{proj.data.summary}</p>

            <div class="project-skills">
              <h3 class="skills-label">Skills Practised:</h3>
              <ul class="skills-list">
                {proj.data.skills.map(s => (
                  <li><span class="badge">{s}</span></li>
                ))}
              </ul>
            </div>

            <div class="project-footer">
              <a href={`/projects/${slug}/`} class="btn btn-primary project-cta">
                <span>Start Project Walkthrough</span>
                <span class="link-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </main>
</BaseLayout>

<style>
  .page-header {
    margin-block-end: var(--space-8);
    padding-block-end: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .lead {
    font-size: var(--font-size-lg);
    color: var(--ink-secondary);
    line-height: var(--line-height-relaxed);
    max-inline-size: 68ch;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--space-6);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .project-card:hover {
    border-color: var(--accent-word);
    box-shadow: 0 4px 12px 0 rgb(15 82 186 / 8%);
  }

  .project-header {
    margin-block-end: var(--space-3);
  }

  .project-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-end: var(--space-3);
  }

  .project-title {
    font-size: var(--font-size-xl);
    color: var(--ink-primary);
    margin: 0;
    line-height: var(--line-height-snug);
  }

  .project-summary {
    color: var(--ink-secondary);
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    margin-block-end: var(--space-4);
    flex-grow: 1;
  }

  .project-skills {
    margin-block-end: var(--space-6);
    border-top: 1px solid var(--border-subtle);
    padding-block-start: var(--space-4);
  }

  .skills-label {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
    margin: 0;
    margin-block-end: var(--space-2);
  }

  .skills-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-footer {
    border-top: 1px solid var(--border-subtle);
    padding-block-start: var(--space-4);
  }

  .project-cta {
    inline-size: 100%;
    justify-content: center;
    gap: var(--space-2);
  }

  .link-arrow {
    transition: transform 0.15s ease;
  }

  .project-cta:hover .link-arrow {
    transform: translateX(3px);
  }

  @media (forced-colors: active) {
    .project-card {
      border: 1px solid ButtonText !important;
    }

    .project-card:hover {
      border: 2px solid Highlight !important;
    }
  }
</style>
