---
import BaseLayout from "../layouts/BaseLayout.astro";
import WrapSimulator from "../components/interactive/WrapSimulator.astro";
import AnchorSimulator from "../components/interactive/AnchorSimulator.astro";
import BoxMarginSimulator from "../components/interactive/BoxMarginSimulator.astro";
import AlignSimulator from "../components/interactive/AlignSimulator.astro";
---

<BaseLayout title="Interactive Layout Sandboxes">
  <main id="content" class="page-main sandboxes-main" tabindex="-1">
    <div class="page-header">
      <div class="header-content">
        <span class="badge badge-ribbon">Hands-On Practice</span>
        <h1>Interactive Layout Sandboxes</h1>
        <p class="lead">
          Practise with Microsoft Word's core positioning mechanics in real time. Experiment with text wrapping, object anchors, text box margins, and precision alignment without fear of breaking a document.
        </p>
      </div>

      <nav class="sandboxes-jump-nav" aria-label="Jump to sandbox">
        <span class="jump-nav-label">Jump to a sandbox:</span>
        <div class="jump-pills">
          <a href="#wrap" class="jump-pill">
            <span aria-hidden="true">🔄</span>
            <span>1. Text Wrapping</span>
          </a>
          <a href="#anchor" class="jump-pill">
            <span aria-hidden="true">⚓</span>
            <span>2. Object Anchors</span>
          </a>
          <a href="#box-margin" class="jump-pill">
            <span aria-hidden="true">📐</span>
            <span>3. Box Margins</span>
          </a>
          <a href="#align" class="jump-pill">
            <span aria-hidden="true">📏</span>
            <span>4. Precision Alignment</span>
          </a>
          <a href="/lessons" class="jump-pill jump-curriculum">
            <span aria-hidden="true">📚</span>
            <span>All 14 Lessons</span>
          </a>
        </div>
      </nav>
    </div>

    <section class="sandboxes-section" aria-labelledby="sandboxes-heading">
      <h2 id="sandboxes-heading" class="visually-hidden">Interactive Simulators List</h2>

      <div class="sandboxes-stack">
        <div id="wrap" class="sandbox-wrapper">
          <WrapSimulator />
        </div>
        <div id="anchor" class="sandbox-wrapper">
          <AnchorSimulator />
        </div>
        <div id="box-margin" class="sandbox-wrapper">
          <BoxMarginSimulator />
        </div>
        <div id="align" class="sandbox-wrapper">
          <AlignSimulator />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .sandboxes-main {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-4);
    padding-block: var(--space-8);
  }

  .page-header {
    margin-block-end: var(--space-8);
    padding-block-end: var(--space-6);
    border-bottom: 1px solid var(--border-subtle);
  }

  .lead {
    font-size: var(--font-size-lg);
    color: var(--ink-secondary);
    max-inline-size: var(--max-prose-width);
  }

  .sandboxes-jump-nav {
    margin-block-start: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .jump-nav-label {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-secondary);
  }

  .jump-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .jump-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--target-min-size);
    min-inline-size: var(--target-min-size);
    padding-inline: var(--space-4);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--ink-primary);
    background-color: var(--surface-card);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .jump-pill:hover {
    background-color: var(--accent-word-bg);
    border-color: var(--accent-word);
    color: var(--accent-word);
  }

  .jump-pill.jump-curriculum {
    background-color: var(--surface-subtle);
    border-color: var(--border-subtle);
    margin-inline-start: auto;
  }

  .jump-pill.jump-curriculum:hover {
    background-color: var(--accent-word-bg);
    border-color: var(--accent-word);
    color: var(--accent-word);
  }

  @media (max-width: 640px) {
    .jump-pill.jump-curriculum {
      margin-inline-start: 0;
    }
  }

  .sandboxes-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .sandbox-wrapper {
    scroll-margin-top: 5rem;
  }

  @media (forced-colors: active) {
    .jump-pill {
      border: 1px solid ButtonText !important;
    }
  }
</style>
