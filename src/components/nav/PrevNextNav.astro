---
import { getCollection } from "astro:content";
import { getAdjacentLessons } from "../../data/curriculum";

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const authored = await getCollection("lessons");
const { prev, next } = getAdjacentLessons(currentSlug, authored);
---

<nav class="prev-next-nav" aria-label="Adjacent lessons">
  <div class="nav-slot prev-slot">
    {prev && (prev.isAvailable ? (
      <a href={`/lessons/${prev.slug}`} class="nav-card">
        <span class="nav-direction">← Previous Lesson</span>
        <span class="nav-title">{prev.order}. {prev.title}</span>
      </a>
    ) : (
      <div class="nav-card is-disabled">
        <span class="nav-direction">← Previous Lesson</span>
        <span class="nav-title">{prev.order}. {prev.title}</span>
      </div>
    ))}
  </div>

  <div class="nav-slot next-slot">
    {next && (next.isAvailable ? (
      <a href={`/lessons/${next.slug}`} class="nav-card">
        <span class="nav-direction">Next Lesson →</span>
        <span class="nav-title">{next.order}. {next.title}</span>
      </a>
    ) : (
      <div class="nav-card is-disabled">
        <span class="nav-direction">Next Lesson →</span>
        <span class="nav-title">{next.order}. {next.title}</span>
        <span class="nav-badge">Coming in Phase 3</span>
      </div>
    ))}
  </div>
</nav>

<style>
  .prev-next-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-block-start: var(--space-10);
    padding-block-start: var(--space-6);
    border-top: 1px solid var(--border-subtle);
  }

  @media (max-width: 640px) {
    .prev-next-nav {
      grid-template-columns: 1fr;
    }
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    background-color: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    height: 100%;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .nav-card:hover:not(.is-disabled) {
    border-color: var(--accent-word);
    transform: translateY(-1px);
  }

  .nav-card.is-disabled {
    opacity: 0.85;
    cursor: default;
  }

  .nav-card.is-disabled .nav-title {
    color: var(--ink-secondary);
  }

  .nav-direction {
    font-size: var(--font-size-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-secondary);
    margin-block-end: var(--space-1);
  }

  .nav-title {
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--accent-word);
    line-height: 1.35;
  }

  .nav-badge {
    align-self: flex-start;
    font-size: 0.75rem;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-ui);
    color: var(--ink-secondary);
    margin-block-start: var(--space-2);
  }
</style>
