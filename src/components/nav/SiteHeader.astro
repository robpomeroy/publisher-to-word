---
import { isCurrent } from "../../utils/nav";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const isSandboxesActive = isCurrent(currentPath, "/sandboxes");
const isLessonsCurriculumActive = isCurrent(currentPath, "/lessons") && !isSandboxesActive;
const isLessonsActive = isLessonsCurriculumActive || isSandboxesActive;

const PRIMARY_LINKS_BEFORE = [
  { href: "/start-here", label: "Start Here" },
];

const PRIMARY_LINKS_AFTER = [
  { href: "/translator", label: "Translator" },
  { href: "/rescue", label: "Rescue Guide" },
  { href: "/projects", label: "Projects" },
  { href: "/cheat-sheet", label: "Cheat Sheet" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="site-brand" href="/" aria-label="Publisher to Word Guide Home">
      <svg class="brand-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="28" height="28" fill="none" aria-hidden="true">
        <rect x="4" y="2" width="24" height="28" rx="3" fill="#FAF9F6" stroke="#94A3B8" stroke-width="2"/>
        <rect x="8" y="6" width="16" height="4" rx="1.5" fill="#1D4ED8"/>
        <rect x="8" y="13" width="7" height="7" rx="1.5" fill="#0F766E"/>
        <rect x="17" y="13" width="7" height="2" rx="1" fill="#94A3B8"/>
        <rect x="17" y="17" width="5" height="2" rx="1" fill="#94A3B8"/>
      </svg>
      <span class="brand-text">
        <span class="brand-publisher">Publisher</span>
        <span class="brand-arrow" aria-hidden="true">→</span>
        <span class="brand-word">Word</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <button
        class="menu-button"
        type="button"
        popovertarget="site-menu"
        popovertargetaction="toggle"
        aria-controls="site-menu"
      >
        <svg class="menu-icon" viewBox="0 0 20 20" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M2.5 5A.75.75 0 013.25 4.25h13.5a.75.75 0 010 1.5H3.25A.75.75 0 012.5 5zm0 5A.75.75 0 013.25 9.25h13.5a.75.75 0 010 1.5H3.25A.75.75 0 012.5 10zm0 5a.75.75 0 01.75-.75h13.5a.75.75 0 010 1.5H3.25a.75.75 0 01-.75-.75z" clip-rule="evenodd" />
        </svg>
        <span>Menu</span>
      </button>

      <ul id="site-menu" class="site-menu" popover="auto">
        {PRIMARY_LINKS_BEFORE.map(link => {
          const current = isCurrent(currentPath, link.href);
          return (
            <li>
              <a
                href={link.href}
                class:list={["nav-link", { "is-active": current }]}
                aria-current={current ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}

        <li class="nav-dropdown">
          <button
            id="lessons-menu-trigger"
            class:list={["nav-link", "dropdown-trigger", { "is-active": isLessonsActive }]}
            type="button"
            aria-expanded="false"
            aria-controls="lessons-submenu"
            popovertarget="lessons-submenu"
          >
            <span>Lessons</span>
            <svg class="dropdown-chevron" viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M3.22 5.47a.75.75 0 0 1 1.06 0L8 9.19l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L3.22 6.53a.75.75 0 0 1 0-1.06z" clip-rule="evenodd" />
            </svg>
          </button>

          <ul id="lessons-submenu" class="dropdown-list">
            <li>
              <a
                href="/lessons"
                class:list={["dropdown-link", { "is-active": isLessonsCurriculumActive }]}
                aria-current={isLessonsCurriculumActive ? "page" : undefined}
              >
                <span class="dropdown-link-title">All 14 Lessons</span>
                <span class="dropdown-link-desc">Step-by-step visual curriculum</span>
              </a>
            </li>
            <li>
              <a
                href="/sandboxes"
                class:list={["dropdown-link", { "is-active": isSandboxesActive }]}
                aria-current={isSandboxesActive ? "page" : undefined}
              >
                <span class="dropdown-link-title">Visual Sandboxes</span>
                <span class="dropdown-link-desc">Interactive layout simulators</span>
              </a>
            </li>
          </ul>
        </li>

        {PRIMARY_LINKS_AFTER.map(link => {
          const current = isCurrent(currentPath, link.href);
          return (
            <li>
              <a
                href={link.href}
                class:list={["nav-link", { "is-active": current }]}
                aria-current={current ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

{/* Pre-paint layout execution: prevents flashing of menu button on wide desktop viewports */}
<script is:inline>
  (function() {
    try {
      var header = document.querySelector(".site-header");
      var inner = header ? header.querySelector(".header-inner") : null;
      var menu = document.getElementById("site-menu");
      var submenu = document.getElementById("lessons-submenu");
      var submenuTrigger = document.getElementById("lessons-menu-trigger");
      if (header && inner && menu) {
        header.classList.add("is-measuring", "is-wide");
        var fits = inner.scrollWidth <= inner.clientWidth;
        header.classList.remove("is-measuring");
        header.classList.toggle("is-wide", fits);
        if (fits) {
          menu.removeAttribute("popover");
          if (submenu) {
            submenu.setAttribute("popover", "auto");
            submenu.hidden = false;
          }
          if (submenuTrigger) {
            submenuTrigger.setAttribute("aria-expanded", "false");
          }
        } else {
          menu.setAttribute("popover", "auto");
          if (submenu) {
            submenu.removeAttribute("popover");
            submenu.hidden = true;
          }
          if (submenuTrigger) {
            submenuTrigger.setAttribute("aria-expanded", "false");
          }
        }
      }
    } catch {
      // Ignore pre-paint measurement errors
    }
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--surface-card);
    border-bottom: 1px solid var(--border-subtle);
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 3%);
    min-block-size: var(--header-height);
    display: flex;
    align-items: center;
    transition: transform 0.25s ease-in-out;
  }

  /* Auto-hide while scrolling down (Container Scroll-State Queries) */
  @container scroll-state((scrolled: bottom) and (scrollable: top)) {
    .site-header {
      transform: translateY(-100%);
    }
  }

  /* Keep header visible whenever keyboard focus is inside or menu is open */
  .site-header:focus-within,
  .site-header:has([popover]:popover-open),
  .site-header:has([class~=":popover-open"]) {
    transform: none !important;
  }

  /* JavaScript passive scroll fallback */
  .site-header.is-hidden:not(:focus-within, :has([popover]:popover-open), :has([class~=":popover-open"])) {
    transform: translateY(-100%);
  }

  .header-inner {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .header-inner > * {
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* Brand: flex-shrink 0 ensures logo is never crushed before navbar switches */
  .site-brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--ink-primary);
    font-weight: 700;
    font-size: var(--font-size-lg);
    padding: var(--space-2);
    border-radius: var(--radius-md);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .site-nav {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .brand-icon {
    flex-shrink: 0;
  }

  .brand-publisher {
    color: var(--accent-publisher);
  }

  .brand-arrow {
    color: var(--ink-secondary);
    font-weight: 400;
  }

  .brand-word {
    color: var(--accent-word);
  }

  /* Mobile menu button */
  .menu-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--target-min-size);
    padding: var(--space-2) var(--space-3);
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-md);
    color: var(--ink-primary);
    font-family: inherit;
    font-size: var(--font-size-sm);
    font-weight: 600;
    cursor: pointer;
    anchor-name: --menu-button;
  }

  .menu-button:hover {
    background-color: var(--surface-hover);
  }

  /* Collapsed layout (native popover) */
  .site-menu {
    position: fixed;
    inset: auto;
    inset-block-start: 4.25rem;
    inset-block-start: anchor(--menu-button bottom);
    inset-inline-end: 1rem;
    inline-size: min(85dvw, 20rem);
    max-inline-size: calc(100dvw - 2rem);
    block-size: fit-content;
    max-block-size: calc(100dvh - 6rem);
    margin: 0;
    padding: var(--space-3);
    list-style: none;
    background-color: var(--surface-card);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -2px rgb(0 0 0 / 5%);
    overflow: auto;
  }

  .site-menu li {
    margin: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    min-block-size: var(--target-min-size);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink-primary);
    font-weight: 600;
    background: transparent;
    border: none;
    font-family: inherit;
    font-size: inherit;
    cursor: pointer;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .nav-link:hover {
    background-color: var(--surface-subtle);
    color: var(--accent-word);
  }

  /* Current page indicator */
  .nav-link[aria-current="page"],
  .nav-link.is-active {
    background-color: var(--accent-word-bg);
    color: var(--accent-word);
    border-left: 3px solid var(--accent-word);
  }

  /* Dropdown Trigger and Chevrons */
  .dropdown-trigger {
    width: 100%;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .dropdown-chevron {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .dropdown-trigger[aria-expanded="true"] .dropdown-chevron {
    transform: rotate(180deg);
  }

  /* Submenu Lists */
  .dropdown-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Collapsed layout: nested in-flow disclosure */
  :not(.site-header.is-wide) .dropdown-list {
    margin-block-start: var(--space-1);
    padding-inline-start: var(--space-3);
    border-left: 2px solid var(--border-subtle);
    margin-inline-start: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  :not(.site-header.is-wide) .dropdown-list[hidden] {
    display: none !important;
  }

  .dropdown-link {
    display: flex;
    flex-direction: column;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--ink-primary);
    min-block-size: var(--target-min-size);
    justify-content: center;
  }

  .dropdown-link:hover {
    background-color: var(--surface-subtle);
    color: var(--accent-word);
  }

  .dropdown-link[aria-current="page"],
  .dropdown-link.is-active {
    background-color: var(--accent-word-bg);
    color: var(--accent-word);
  }

  .dropdown-link-title {
    font-weight: 600;
    font-size: var(--font-size-sm);
  }

  .dropdown-link-desc {
    font-size: var(--font-size-xs);
    color: var(--ink-secondary);
    font-weight: 400;
  }

  /* Wide layout (Inline Navigation) */
  .site-header.is-wide .menu-button {
    display: none;
  }

  .site-header.is-wide .site-menu {
    position: static;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    inline-size: auto;
    max-inline-size: none;
    block-size: auto;
    max-block-size: none;
    overflow: visible;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .site-header.is-wide .site-menu > li {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .site-header.is-wide .site-menu::backdrop {
    display: none;
  }

  .site-header.is-wide .nav-link {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    border-left: none;
    position: relative;
  }

  .site-header.is-wide .nav-link[aria-current="page"],
  .site-header.is-wide .nav-link.is-active {
    background-color: transparent;
    color: var(--accent-word);
  }

  .site-header.is-wide .dropdown-trigger {
    width: auto;
    anchor-name: --lessons-trigger;
  }

  /* Visual bottom pill indicator with high contrast (>= 3:1) */
  .site-header.is-wide .nav-link[aria-current="page"]::after,
  .site-header.is-wide .nav-link.is-active::after {
    content: "";
    position: absolute;
    inset-inline: var(--space-3);
    inset-block-end: 0;
    block-size: 3px;
    background-color: var(--accent-word);
    border-radius: var(--radius-pill);
  }

  /* Wide layout: Submenu floating popover */
  .site-header.is-wide .nav-dropdown {
    position: relative;
  }

  .site-header.is-wide .dropdown-list[popover] {
    position: absolute;
    position-anchor: --lessons-trigger;
    position-area: block-end span-inline-end;
    position-try-fallbacks: flip-block, flip-inline;
    inset: auto;
    height: auto;
    inline-size: max-content;
    min-inline-size: 15rem;
    margin-block-start: 0.5rem;
    overflow: visible;
    padding: var(--space-2);
    background-color: var(--surface-card);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -2px rgb(0 0 0 / 5%);
  }

  /* Hover bridge prevents pointerleave during mouse movement from button into popover */
  .site-header.is-wide .dropdown-list::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 100%;
    block-size: 0.5rem;
  }

  .site-header.is-wide .dropdown-list:not(:is(:popover-open, [class~=":popover-open"])) {
    display: none;
  }

  .site-header.is-wide .dropdown-list:is(:popover-open, [class~=":popover-open"]) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  @supports not (position-area: block-end) {
    .site-header.is-wide .dropdown-list[popover] {
      position: fixed;
      margin: 0;
    }
  }

  /* High contrast mode support */
  @media (forced-colors: active) {
    .site-header.is-wide .nav-link[aria-current="page"]::after,
    .site-header.is-wide .nav-link.is-active::after {
      background-color: Highlight;
    }

    .dropdown-list {
      border: 1px solid ButtonText !important;
    }
  }

  /* Measuring state prevents flicker during resize */
  .is-measuring * {
    transition: none !important;
  }
</style>

<script>
  import { measureNavFits, applyNavLayout, computeSubmenuFallbackPosition } from "../../utils/nav";

  // Progressive Enhancement for Popover API
  if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
    import("@oddbird/popover-polyfill");
  }

  // Adaptive Content-Aware Navbar (modern-web-guidance)
  const header = document.querySelector<HTMLElement>(".site-header");
  const inner = header?.querySelector<HTMLElement>(".header-inner");
  const menu = document.getElementById("site-menu");
  const menuBtn = header?.querySelector<HTMLButtonElement>(".menu-button");
  const dropdown = header?.querySelector<HTMLElement>(".nav-dropdown");
  const submenu = document.getElementById("lessons-submenu");
  const submenuTrigger = document.getElementById("lessons-menu-trigger") as HTMLButtonElement | null;

  if (header && inner && menu) {
    let isCurrentlyWide: boolean | null = null;
    let isHoverPreview = false;
    let rafId: number | null = null;

    const updateNavLayout = (immediate = false) => {
      const run = () => {
        const fitsInline = measureNavFits(header, inner);

        if (fitsInline !== isCurrentlyWide) {
          isCurrentlyWide = fitsInline;
          applyNavLayout({ header, menu, menuBtn, submenu, submenuTrigger }, fitsInline);
        }
      };

      if (immediate) {
        run();
      } else {
        if (rafId !== null) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(run);
      }
    };

    // Run initial check immediately
    updateNavLayout(true);

    const resizeObserver = new ResizeObserver(() => {
      updateNavLayout(false);
    });

    resizeObserver.observe(inner);

    window.addEventListener("resize", () => {
      updateNavLayout(false);
    }, { passive: true });

    // Submenu interactive handling
    if (dropdown && submenu && submenuTrigger) {
      const canHover = window.matchMedia("(hover: hover)");

      // Hover preview in wide mode
      dropdown.addEventListener("pointerenter", (e) => {
        if (!header.classList.contains("is-wide")) return;
        if (!canHover.matches || e.pointerType === "touch") return;

        if (typeof submenu.showPopover === "function" && !submenu.matches?.(":popover-open")) {
          try {
            submenu.showPopover();
            isHoverPreview = true;
          } catch {
            // Ignore if polyfill or state error
          }
        }
      });

      dropdown.addEventListener("pointerleave", (e) => {
        if (!header.classList.contains("is-wide")) return;
        if (!canHover.matches || e.pointerType === "touch") return;

        if (isHoverPreview && typeof submenu.hidePopover === "function" && submenu.matches?.(":popover-open")) {
          try {
            submenu.hidePopover();
          } catch {
            // Ignore
          }
          isHoverPreview = false;
        }
      });

      // Click handling
      submenuTrigger.addEventListener("click", (e) => {
        if (header.classList.contains("is-wide")) {
          if (isHoverPreview) {
            isHoverPreview = false;
            e.preventDefault();
          }
        } else {
          // Narrow mode: toggle in-flow disclosure
          e.preventDefault();
          const isHidden = submenu.hidden;
          submenu.hidden = !isHidden;
          submenuTrigger.setAttribute("aria-expanded", isHidden ? "true" : "false");
        }
      });

      // Close when keyboard focus leaves dropdown in wide mode
      dropdown.addEventListener("focusout", (e) => {
        if (!header.classList.contains("is-wide")) return;
        const nextTarget = e.relatedTarget as Node | null;
        if (nextTarget && dropdown.contains(nextTarget)) return;

        if (typeof submenu.hidePopover === "function" && submenu.matches?.(":popover-open")) {
          try {
            submenu.hidePopover();
          } catch {
            // Ignore
          }
          isHoverPreview = false;
        }
      });

      // Synchronise aria-expanded and fallback positioning on toggle
      submenu.addEventListener("toggle", (e: Event) => {
        const toggleEvent = e as ToggleEvent;
        const isOpen = toggleEvent.newState === "open";
        submenuTrigger.setAttribute("aria-expanded", isOpen ? "true" : "false");

        if (!isOpen) {
          isHoverPreview = false;
        } else if (!CSS.supports("position-area", "block-end") && header.classList.contains("is-wide")) {
          const trigRect = submenuTrigger.getBoundingClientRect();
          const subRect = submenu.getBoundingClientRect();
          const coords = computeSubmenuFallbackPosition(trigRect, subRect, {
            innerWidth: window.innerWidth,
            innerHeight: window.innerHeight,
          });
          submenu.style.top = `${coords.top}px`;
          submenu.style.left = `${coords.left}px`;
        }
      });
    }
  }

  // Scroll down auto-hide fallback for browsers without Container Scroll-State queries
  if (!CSS.supports("container-type", "scroll-state")) {
    const bar = document.querySelector(".site-header");
    let lastY = window.scrollY;

    window.addEventListener("scroll", () => {
      const y = Math.max(0, Math.min(window.scrollY, document.documentElement.scrollHeight - window.innerHeight));
      if (y === lastY) return;

      if (bar) {
        const barHeight = (bar as HTMLElement).offsetHeight || 60;
        bar.classList.toggle("is-hidden", y > lastY && y > barHeight);
      }
      lastY = y;
    }, { passive: true });
  }
</script>
