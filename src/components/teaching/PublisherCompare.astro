---
interface Props {
  title?: string;
  publisherWay: string;
  wordWay: string;
}

const {
  title = "Coming from Microsoft Publisher",
  publisherWay,
  wordWay,
} = Astro.props;
---

<aside class="callout callout-publisher publisher-compare" aria-labelledby="pub-compare-title">
  <div class="callout-header">
    <svg
      class="compare-title-icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M16 3h5v5"></path>
      <path d="M8 21H3v-5"></path>
      <path d="M21 3 14 10"></path>
      <path d="m3 21 7-7"></path>
    </svg>
    <h3 id="pub-compare-title" class="compare-heading">{title}</h3>
  </div>

  <div class="compare-grid">
    <div class="compare-col publisher-col">
      <div class="col-badge">
        <svg
          class="col-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="3" width="18" height="18" rx="2"></rect>
          <path d="M3 9h18"></path>
          <path d="M9 21V9"></path>
        </svg>
        <span class="col-title">In Microsoft Publisher</span>
      </div>
      <p class="compare-text">{publisherWay}</p>
    </div>

    <div class="compare-divider" aria-hidden="true">
      <span class="arrow-pill">→</span>
    </div>

    <div class="compare-col word-col">
      <div class="col-badge">
        <svg
          class="col-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
        <span class="col-title">How It Works in Word</span>
      </div>
      <p class="compare-text">{wordWay}</p>
    </div>
  </div>

  <div class="compare-extra">
    <slot />
  </div>
</aside>

<style>
  .publisher-compare {
    margin-block: var(--space-6);
  }

  .compare-title-icon {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    flex-shrink: 0;
  }

  .compare-heading {
    margin: 0;
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--accent-publisher);
    line-height: var(--line-height-tight);
  }

  .compare-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: stretch;
    margin-block: var(--space-4);
  }

  @media (min-width: 640px) {
    .compare-grid {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }
  }

  .compare-col {
    background-color: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
  }

  .publisher-col {
    border-inline-start: 4px solid var(--accent-publisher);
  }

  .word-col {
    border-inline-start: 4px solid var(--accent-word);
  }

  .col-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: 700;
  }

  .publisher-col .col-badge {
    color: var(--accent-publisher);
  }

  .word-col .col-badge {
    color: var(--accent-word);
  }

  .col-icon {
    inline-size: 1.125rem;
    block-size: 1.125rem;
  }

  .compare-text {
    margin: 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
    color: var(--ink-primary);
  }

  .compare-divider {
    display: none;
    justify-content: center;
    align-items: center;
  }

  @media (min-width: 640px) {
    .compare-divider {
      display: flex;
    }
  }

  .arrow-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: var(--radius-pill);
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    color: var(--ink-secondary);
    font-weight: 700;
  }

  .compare-extra:empty {
    display: none;
  }

  .compare-extra {
    margin-block-start: var(--space-3);
    padding-block-start: var(--space-3);
    border-block-start: 1px dashed var(--accent-publisher-border);
    font-size: var(--font-size-sm);
    color: var(--ink-secondary);
  }

  @media (forced-colors: active) {
    .compare-heading,
    .publisher-col .col-badge,
    .word-col .col-badge {
      color: Highlight;
    }

    .compare-col {
      border: 1px solid ButtonText;
    }
  }
</style>
