---
interface Props {
  summary?: string;
}

const {
  summary = "Using Word on a Mac? View Mac menu & shortcut differences",
} = Astro.props;
---

<details class="disclosure mac-note">
  <summary class="mac-summary">
    <svg
      class="mac-icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M18 3a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3H6a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3V6a3 3 0 0 0-3-3 3 3 0 0 0-3 3 3 3 0 0 0 3 3h12a3 3 0 0 0 3-3 3 3 0 0 0-3-3z"></path>
    </svg>
    <span class="mac-summary-title">{summary}</span>
  </summary>
  <div class="mac-content">
    <slot />
  </div>
</details>

<style>
  .mac-note {
    margin-block: var(--space-4);
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .mac-summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    color: var(--ink-secondary);
  }

  .mac-icon {
    inline-size: 1.125rem;
    block-size: 1.125rem;
    color: var(--ink-secondary);
    flex-shrink: 0;
  }

  .mac-summary-title {
    font-size: var(--font-size-sm);
    color: var(--ink-primary);
  }

  .mac-content {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
    color: var(--ink-primary);
  }

  .mac-content :global(p:last-child) {
    margin-block-end: 0;
  }

  .mac-content :global(kbd) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-ui);
    background-color: var(--surface-card);
    box-shadow: 0 1px 0 var(--border-ui);
  }

  @media (forced-colors: active) {
    .mac-note {
      border: 1px solid ButtonText;
    }

    .mac-summary-title {
      color: CanvasText;
    }
  }

  @media print {
    .mac-note {
      border: 1px solid #000000;
    }
  }
</style>
