---
import {
  INITIAL_ANCHOR_STATE,
  getAnchorStatus,
} from "../../utils/simulators";

const initialStatus = getAnchorStatus(INITIAL_ANCHOR_STATE);
---

<div class="anchor-simulator card" id="anchor-simulator">
  <div class="simulator-header">
    <div class="header-text">
      <h3 id="anchor-sim-title" class="simulator-title">
        <svg
          class="sim-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="5" r="3"></circle>
          <line x1="12" y1="22" x2="12" y2="8"></line>
          <path d="M5 12H2a10 10 0 0 0 20 0h-3"></path>
        </svg>
        Object Anchor & Flow Simulator
      </h3>
      <p class="simulator-subtitle">
        Discover what happens when you insert text above an anchored picture. Toggle between Word's default river flow and Publisher-style page pinning.
      </p>
    </div>
  </div>

  <!-- Mode Toggle & Action Controls -->
  <div class="anchor-controls">
    <div class="control-group">
      <span class="control-label" id="anchor-mode-label">Anchor Behaviour:</span>
      <div class="btn-group" role="radiogroup" aria-labelledby="anchor-mode-label">
        <button
          type="button"
          class="btn-anchor-mode is-active"
          id="btn-mode-move"
          data-mode="move-with-text"
          role="radio"
          aria-checked="true"
          tabindex="0"
        >
          Move with text (Word default)
        </button>
        <button
          type="button"
          class="btn-anchor-mode"
          id="btn-mode-fix"
          data-mode="fix-position"
          role="radio"
          aria-checked="false"
          tabindex="-1"
        >
          Fix position on page (Publisher style)
        </button>
      </div>
    </div>

    <div class="action-group">
      <button
        type="button"
        class="btn btn-primary btn-action"
        id="btn-add-paragraph"
      >
        + Add Paragraph Above
      </button>
      <button
        type="button"
        class="btn btn-secondary btn-action"
        id="btn-reset-anchor"
      >
        Reset Page
      </button>
    </div>
  </div>

  <!-- Informative Status Strip -->
  <div class="anchor-status-banner">
    <div class="status-indicator">
      <span class="indicator-icon" aria-hidden="true">⚓</span>
      <span class="status-summary" id="anchor-summary-text">
        Current mode: <strong>Move with text</strong>. Photo is anchored to Paragraph 1.
      </span>
    </div>
    <span class="badge" id="anchor-para-count">0 paragraphs added</span>
  </div>

  <!-- Mock Word Document Canvas -->
  <div class="mock-anchor-page" id="mock-anchor-page">
    <div class="page-top-margin">
      <span class="margin-indicator" aria-hidden="true">Top Margin (2.54 cm)</span>
    </div>

    <div class="page-content-area" id="anchor-content-area">
      <!-- Dynamic Stream of Paragraphs Inserted Above -->
      <div class="stream-container" id="stream-container">
        <!-- New paragraphs injected dynamically -->
      </div>

      <!-- The Anchored Host Paragraph -->
      <div class="host-paragraph-row" id="host-paragraph-row">
        <!-- Anchor Flag Icon attached to this paragraph -->
        <div class="anchor-marker" id="anchor-marker" title="Object anchor point">
          <span class="anchor-glyph" aria-hidden="true">⚓</span>
          <span class="sr-only">Anchor point attached to paragraph 1</span>
        </div>
        <p class="mock-paragraph host-p">
          <strong>Paragraph 1 (Host Paragraph):</strong> This is the sentence holding the picture anchor. In Word, every floating picture attaches its anchor to a specific paragraph mark (¶).
        </p>
      </div>

      <p class="mock-paragraph trailing-p">
        <strong>Paragraph 2:</strong> When text flows downstream, anything anchored to paragraphs above it stays in relative lockstep unless pinned to the page margin.
      </p>

      <!-- The Floating Photo -->
      <div class="floating-photo" id="floating-photo">
        <div class="photo-card">
          <div class="photo-graphic" aria-hidden="true">
            <svg viewBox="0 0 100 70" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="100" height="70" rx="3" fill="#E2E8F0" />
              <circle cx="30" cy="25" r="10" fill="#93C5FD" />
              <polygon points="10,60 40,30 70,55 90,35 95,60" fill="#3B82F6" />
            </svg>
          </div>
          <div class="photo-info">
            <span class="photo-title">Landscape Photo</span>
            <span class="photo-mode-tag" id="photo-mode-tag">Moving with text</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Assistive Live Region -->
  <div class="sr-only" role="status" aria-live="polite" id="anchor-live-status">
    {initialStatus}
  </div>
</div>

<script>
  import {
    addParagraph,
    calculatePhotoOffset,
    getAnchorStatus,
    resetAnchorState,
    setAnchorMode,
    type AnchorState,
  } from "../../utils/simulators";

  const root = document.getElementById("anchor-simulator");
  if (root) {
    let state: AnchorState = {
      mode: "move-with-text",
      addedParagraphs: 0,
    };

    const btnMove = root.querySelector<HTMLButtonElement>("#btn-mode-move");
    const btnFix = root.querySelector<HTMLButtonElement>("#btn-mode-fix");
    const btnAdd = root.querySelector<HTMLButtonElement>("#btn-add-paragraph");
    const btnReset = root.querySelector<HTMLButtonElement>("#btn-reset-anchor");
    const streamContainer = root.querySelector<HTMLDivElement>("#stream-container");
    const floatingPhoto = root.querySelector<HTMLDivElement>("#floating-photo");
    const photoModeTag = root.querySelector<HTMLSpanElement>("#photo-mode-tag");
    const summaryText = root.querySelector<HTMLSpanElement>("#anchor-summary-text");
    const paraCountBadge = root.querySelector<HTMLSpanElement>("#anchor-para-count");
    const liveStatus = root.querySelector<HTMLDivElement>("#anchor-live-status");

    const modeBtns = [btnMove, btnFix].filter((b): b is HTMLButtonElement => Boolean(b));

    function setMode(mode: "move-with-text" | "fix-position", focusBtn?: HTMLButtonElement) {
      state = setAnchorMode(state, mode);
      modeBtns.forEach((b) => {
        const isSelected = b.getAttribute("data-mode") === mode;
        b.classList.toggle("is-active", isSelected);
        b.setAttribute("aria-checked", isSelected ? "true" : "false");
        b.setAttribute("tabindex", isSelected ? "0" : "-1");
      });
      if (focusBtn) focusBtn.focus();
      render();
    }

    modeBtns.forEach((btn, index) => {
      btn.addEventListener("click", () => {
        const m = btn.getAttribute("data-mode") as "move-with-text" | "fix-position";
        if (m) setMode(m, btn);
      });
      btn.addEventListener("keydown", (e) => {
        let nextIndex = -1;
        if (e.key === "ArrowRight" || e.key === "ArrowDown") {
          e.preventDefault();
          nextIndex = (index + 1) % modeBtns.length;
        } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
          e.preventDefault();
          nextIndex = (index - 1 + modeBtns.length) % modeBtns.length;
        }
        if (nextIndex >= 0) {
          const nextBtn = modeBtns[nextIndex];
          const m = nextBtn.getAttribute("data-mode") as "move-with-text" | "fix-position";
          if (m) setMode(m, nextBtn);
        }
      });
    });

    function render() {
      // Render added paragraphs
      if (streamContainer) {
        streamContainer.innerHTML = "";
        for (let i = 1; i <= state.addedParagraphs; i++) {
          const p = document.createElement("p");
          p.className = "mock-paragraph inserted-p";
          p.innerHTML = `<strong>[Added Paragraph ${i}]:</strong> New content inserted above the host paragraph pushes the stream forward.`;
          streamContainer.appendChild(p);
        }
      }

      // Position floating photo based on actual measured displacement of stream container
      if (floatingPhoto) {
        const paraHeight =
          state.addedParagraphs > 0 && streamContainer
            ? streamContainer.offsetHeight / state.addedParagraphs
            : 0;
        const offsetPx = calculatePhotoOffset(state, paraHeight);
        floatingPhoto.style.transform = `translateY(${offsetPx}px)`;
      }

      if (photoModeTag) {
        photoModeTag.textContent =
          state.mode === "move-with-text" ? "Moving with text" : "Pinned to page";
      }

      // Update counters & summaries
      if (paraCountBadge) {
        paraCountBadge.textContent = `${state.addedParagraphs} / 3 added`;
      }

      if (summaryText) {
        summaryText.innerHTML =
          state.mode === "move-with-text"
            ? `Current mode: <strong>Move with text</strong>. Photo shifts down with paragraph stream.`
            : `Current mode: <strong>Fix position on page</strong>. Text flows past while photo remains pinned.`;
      }

      if (btnAdd) {
        btnAdd.disabled = state.addedParagraphs >= 3;
      }

      if (liveStatus) {
        liveStatus.textContent = getAnchorStatus(state);
      }
    }

    btnAdd?.addEventListener("click", () => {
      state = addParagraph(state);
      render();
    });

    btnReset?.addEventListener("click", () => {
      state = resetAnchorState();
      render();
    });
  }
</script>

<style>
  .anchor-simulator {
    margin-block: var(--space-8);
    padding: var(--space-6);
  }

  .simulator-header {
    margin-block-end: var(--space-5);
  }

  .simulator-title {
    margin: 0 0 var(--space-2) 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--ink-primary);
  }

  .sim-icon {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    color: var(--accent-word);
    flex-shrink: 0;
  }

  .simulator-subtitle {
    margin: 0;
    font-size: var(--font-size-base);
    color: var(--ink-secondary);
    line-height: var(--line-height-normal);
  }

  .anchor-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-block-end: var(--space-5);
  }

  @media (min-width: 640px) {
    .anchor-controls {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .control-label {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--ink-secondary);
  }

  .btn-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .btn-anchor-mode {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--target-min-size);
    min-inline-size: var(--target-min-size);
    padding-inline: var(--space-4);
    font-family: inherit;
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--ink-primary);
    background-color: var(--surface-card);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-anchor-mode:hover {
    background-color: var(--surface-hover);
    border-color: var(--accent-word);
  }

  .btn-anchor-mode.is-active {
    background-color: var(--accent-word);
    color: #FFFFFF;
    border-color: var(--accent-word);
  }

  .action-group {
    display: flex;
    gap: var(--space-2);
  }

  .btn-action {
    font-size: var(--font-size-sm);
  }

  /* Status Banner */
  .anchor-status-banner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    margin-block-end: var(--space-5);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .indicator-icon {
    font-size: 1.25rem;
    color: var(--accent-word);
  }

  .status-summary {
    font-size: var(--font-size-sm);
    color: var(--ink-primary);
  }

  /* Mock Page Area */
  .mock-anchor-page {
    background-color: #FFFFFF;
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 10%);
    overflow: hidden;
  }

  .page-top-margin {
    background-color: #F8FAFC;
    border-block-end: 1px dashed var(--border-subtle);
    padding: var(--space-2) var(--space-4);
    text-align: right;
  }

  .margin-indicator {
    font-size: var(--font-size-xs);
    color: var(--ink-muted);
  }

  .page-content-area {
    position: relative;
    padding: var(--space-6);
    min-block-size: 24rem;
  }

  .mock-paragraph,
  .stream-container :global(.mock-paragraph) {
    font-size: var(--font-size-sm);
    line-height: 1.5;
    color: var(--ink-primary);
    margin: 0 0 var(--space-3) 0;
    max-inline-size: 60%;
  }

  .host-paragraph-row {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    background-color: var(--accent-word-bg);
    border-radius: var(--radius-sm);
    padding: var(--space-2);
    margin-block-end: var(--space-3);
    border-inline-start: 3px solid var(--accent-word);
  }

  .anchor-marker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    background-color: #FFFFFF;
    border: 1.5px solid var(--accent-word);
    border-radius: var(--radius-pill);
    color: var(--accent-word);
    font-size: 0.9rem;
    flex-shrink: 0;
    box-shadow: 0 1px 2px rgb(0 0 0 / 10%);
  }

  .host-p {
    margin: 0;
    max-inline-size: 100%;
  }

  .inserted-p,
  .stream-container :global(.inserted-p) {
    background-color: #F0FDF4;
    border-inline-start: 3px solid var(--accent-success);
    border-radius: var(--radius-sm);
    padding: var(--space-2);
    animation: fade-in 0.3s ease;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Floating Photo */
  .floating-photo {
    position: absolute;
    top: 5rem;
    right: var(--space-6);
    inline-size: 12rem;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .photo-card {
    background-color: var(--surface-card);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 15%);
  }

  .photo-graphic svg {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-sm);
  }

  .photo-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-block-start: var(--space-2);
  }

  .photo-title {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--ink-primary);
  }

  .photo-mode-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-word);
  }

  @media (forced-colors: active) {
    .btn-anchor-mode {
      border: 1px solid ButtonText !important;
    }

    .btn-anchor-mode.is-active {
      background-color: Highlight;
      color: HighlightText;
    }

    .photo-card {
      border: 1px solid ButtonText;
    }
  }
</style>
