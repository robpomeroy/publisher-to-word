---
import {
  INITIAL_ANCHOR_STATE,
  getAnchorStatus,
} from "../../utils/simulators";
import { generateDeterministicId } from "../../utils/id";

interface Props {
  id?: string;
}

const { id } = Astro.props;
const simId = id || generateDeterministicId("anchor-sim", "simulator");
const initialStatus = getAnchorStatus(INITIAL_ANCHOR_STATE);
---

<div class="anchor-simulator card" id={id} data-anchor-simulator>
  <div class="simulator-header">
    <div class="header-text">
      <h3 class="simulator-title">
        <svg
          class="sim-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="5" r="3"></circle>
          <line x1="12" y1="22" x2="12" y2="8"></line>
          <path d="M5 12H2a10 10 0 0 0 20 0h-3"></path>
        </svg>
        Object Anchor & Flow Simulator
      </h3>
      <p class="simulator-subtitle">
        Discover what happens when you insert text above an anchored picture. Toggle between Word's default river flow and Publisher-style page pinning.
      </p>
    </div>
  </div>

  <!-- Mode Toggle & Action Controls -->
  <div class="anchor-controls">
    <div class="control-group">
      <span class="control-label" id={`${simId}-mode-label`}>Anchor Behaviour:</span>
      <div class="btn-group" role="radiogroup" aria-labelledby={`${simId}-mode-label`}>
        <button
          type="button"
          class="btn-anchor-mode is-active"
          data-btn-mode-move
          data-mode="move-with-text"
          role="radio"
          aria-checked="true"
          tabindex="0"
        >
          Move with text (Word default)
        </button>
        <button
          type="button"
          class="btn-anchor-mode"
          data-btn-mode-fix
          data-mode="fix-position"
          role="radio"
          aria-checked="false"
          tabindex="-1"
        >
          Fix position on page (Publisher style)
        </button>
      </div>
    </div>

    <div class="action-group">
      <button
        type="button"
        class="btn btn-primary btn-action"
        data-btn-add-paragraph
      >
        + Add Paragraph Above
      </button>
      <button
        type="button"
        class="btn btn-secondary btn-action"
        data-btn-reset-anchor
      >
        Reset Page
      </button>
    </div>
  </div>

  <!-- Informative Status Strip -->
  <div class="anchor-status-banner">
    <div class="status-indicator">
      <span class="indicator-icon" aria-hidden="true">⚓</span>
      <span class="status-summary" data-anchor-summary-text>
        Current mode: <strong>Move with text</strong>. Photo is anchored to Paragraph 1.
      </span>
    </div>
    <span class="badge" data-anchor-para-count>0 paragraphs added</span>
  </div>

  <!-- Mock Word Document Canvas -->
  <div class="mock-anchor-page">
    <div class="page-top-margin">
      <span class="margin-indicator" aria-hidden="true">Top Margin (2.54 cm)</span>
    </div>

    <div class="page-content-area">
      <div class="page-text-column">
        <!-- Dynamic Stream of Paragraphs Inserted Above -->
        <div class="stream-container" data-stream-container>
          <!-- New paragraphs injected dynamically -->
        </div>

        <!-- The Anchored Host Paragraph -->
        <div class="host-paragraph-row">
          <!-- Anchor Flag Icon attached to this paragraph -->
          <div class="anchor-marker" title="Object anchor point">
            <span class="anchor-glyph" aria-hidden="true">⚓</span>
            <span class="visually-hidden">Anchor point attached to paragraph 1</span>
          </div>
          <p class="mock-paragraph host-p">
            <strong>Paragraph 1 (Host Paragraph):</strong> This is the sentence holding the picture anchor. In Word, every floating picture attaches its anchor to a specific paragraph mark (¶).
          </p>
        </div>

        <p class="mock-paragraph trailing-p">
          <strong>Paragraph 2:</strong> When text flows downstream, anything anchored to paragraphs above it stays in relative lockstep unless pinned to the page margin.
        </p>
      </div>

      <!-- The Floating Photo Column -->
      <div class="page-photo-column">
        <div class="floating-photo" data-floating-photo>
          <div class="photo-card">
            <div class="photo-graphic" aria-hidden="true">
              <svg viewBox="0 0 100 70" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="100" height="70" rx="3" fill="#E2E8F0" />
                <circle cx="30" cy="25" r="10" fill="#93C5FD" />
                <polygon points="10,60 40,30 70,55 90,35 95,60" fill="#3B82F6" />
              </svg>
            </div>
            <div class="photo-info">
              <span class="photo-title">Landscape Photo</span>
              <span class="photo-mode-tag" data-photo-mode-tag>Moving with text</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Assistive Live Region -->
  <div class="visually-hidden" role="status" aria-live="polite" data-anchor-live-status>
    {initialStatus}
  </div>
</div>

<script>
  import { initAnchorSimulator } from "../../utils/simulator-controllers";

  document.querySelectorAll<HTMLElement>("[data-anchor-simulator]").forEach(initAnchorSimulator);
</script>

<style>
  .anchor-simulator {
    margin-block: var(--space-8);
    padding: var(--space-6);
  }

  .simulator-header {
    margin-block-end: var(--space-5);
  }

  .simulator-title {
    margin: 0 0 var(--space-2) 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--ink-primary);
  }

  .sim-icon {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    color: var(--accent-word);
    flex-shrink: 0;
  }

  .simulator-subtitle {
    margin: 0;
    font-size: var(--font-size-base);
    color: var(--ink-secondary);
    line-height: var(--line-height-normal);
  }

  .anchor-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-block-end: var(--space-5);
  }

  @media (min-width: 640px) {
    .anchor-controls {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .control-label {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--ink-secondary);
  }

  .btn-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .btn-anchor-mode {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--target-min-size);
    min-inline-size: var(--target-min-size);
    padding-inline: var(--space-4);
    font-family: inherit;
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--ink-primary);
    background-color: var(--surface-card);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-anchor-mode:hover {
    background-color: var(--surface-hover);
    border-color: var(--accent-word);
  }

  .btn-anchor-mode.is-active {
    background-color: var(--accent-word);
    color: #FFFFFF;
    border-color: var(--accent-word);
  }

  .action-group {
    display: flex;
    gap: var(--space-2);
  }

  .btn-action {
    font-size: var(--font-size-sm);
  }

  /* Status Banner */
  .anchor-status-banner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    margin-block-end: var(--space-5);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .indicator-icon {
    font-size: 1.25rem;
    color: var(--accent-word);
  }

  .status-summary {
    font-size: var(--font-size-sm);
    color: var(--ink-primary);
  }

  /* Mock Page Area */
  .mock-anchor-page {
    background-color: #FFFFFF;
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 10%);
    overflow: hidden;
  }

  .page-top-margin {
    background-color: #F8FAFC;
    border-block-end: 1px dashed var(--border-subtle);
    padding: var(--space-2) var(--space-4);
    text-align: right;
  }

  .margin-indicator {
    font-size: var(--font-size-xs);
    color: var(--ink-secondary);
  }

  .page-content-area {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(5.5rem, 7.5rem);
    gap: var(--space-3);
    padding: var(--space-3);
    min-block-size: 24rem;
  }

  @media (min-width: 640px) {
    .page-content-area {
      grid-template-columns: 1fr 12rem;
      gap: var(--space-6);
      padding: var(--space-6);
    }
  }

  .page-text-column {
    min-inline-size: 0;
  }

  .page-photo-column {
    position: relative;
    min-inline-size: 0;
  }

  .mock-paragraph,
  .stream-container :global(.mock-paragraph) {
    font-size: var(--font-size-sm);
    line-height: 1.5;
    color: var(--ink-primary);
    margin: 0 0 var(--space-3) 0;
    max-inline-size: 100%;
  }

  .host-paragraph-row {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    background-color: var(--accent-word-bg);
    border-radius: var(--radius-sm);
    padding: var(--space-2);
    margin-block-end: var(--space-3);
    border-inline-start: 3px solid var(--accent-word);
  }

  .anchor-marker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    background-color: #FFFFFF;
    border: 1.5px solid var(--accent-word);
    border-radius: var(--radius-pill);
    color: var(--accent-word);
    font-size: 0.9rem;
    flex-shrink: 0;
    box-shadow: 0 1px 2px rgb(0 0 0 / 10%);
  }

  .host-p {
    margin: 0;
    max-inline-size: 100%;
  }

  .inserted-p,
  .stream-container :global(.inserted-p) {
    background-color: #F0FDF4;
    border-inline-start: 3px solid var(--accent-success);
    border-radius: var(--radius-sm);
    padding: var(--space-2);
    animation: fade-in 0.3s ease;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Floating Photo */
  .floating-photo {
    position: absolute;
    top: 4.5rem;
    inset-inline-start: 0;
    inline-size: 100%;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .photo-card {
    background-color: var(--surface-card);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 15%);
  }

  .photo-graphic svg {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-sm);
  }

  .photo-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-block-start: var(--space-2);
  }

  .photo-title {
    font-size: var(--font-size-xs);
    font-weight: 700;
    color: var(--ink-primary);
  }

  .photo-mode-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-word);
  }

  @media (forced-colors: active) {
    .btn-anchor-mode {
      border: 1px solid ButtonText !important;
    }

    .btn-anchor-mode.is-active {
      background-color: Highlight;
      color: HighlightText;
    }

    .photo-card {
      border: 1px solid ButtonText;
    }
  }
</style>
