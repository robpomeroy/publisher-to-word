---
import { getHotspots } from "../../utils/simulators";

const hotspots = getHotspots();
---

<div class="hotspot-map-container">
  <div class="hotspot-intro">
    <h3 id="hotspot-map-heading" class="hotspot-title">
      <svg
        class="title-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      The Three Word Layout Control Locations
    </h3>
    <p class="hotspot-intro-text">
      Publisher kept all tools in persistent toolbars. In Word, layout controls live in three specific places. Select any numbered pin on the schematic below to explore its role.
    </p>
  </div>

  <div class="schematic-canvas" aria-labelledby="hotspot-map-heading">
    <!-- Visual schematic of Word's interface -->
    <svg
      class="word-schematic-svg"
      viewBox="0 0 760 420"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <defs>
        <pattern id="grid-dots" width="20" height="20" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1" fill="#CBD5E1" />
        </pattern>
      </defs>

      <!-- App Window Background -->
      <rect x="0" y="0" width="760" height="420" rx="8" fill="#F1F5F9" stroke="#94A3B8" stroke-width="1.5" />

      <!-- Title Bar -->
      <path d="M 0 8 Q 0 0 8 0 L 752 0 Q 760 0 760 8 L 760 32 L 0 32 Z" fill="#1D4ED8" />
      <circle cx="20" cy="16" r="5" fill="#93C5FD" />
      <text x="35" y="20" fill="#FFFFFF" font-family="sans-serif" font-size="12" font-weight="600">Newsletter.docx - Word</text>

      <!-- Ribbon Tab Row -->
      <rect x="0" y="32" width="760" height="28" fill="#E2E8F0" />
      <text x="20" y="50" fill="#475569" font-family="sans-serif" font-size="11">File</text>
      <text x="56" y="50" fill="#475569" font-family="sans-serif" font-size="11">Home</text>
      <text x="100" y="50" fill="#475569" font-family="sans-serif" font-size="11">Insert</text>
      <text x="146" y="50" fill="#475569" font-family="sans-serif" font-size="11">Layout</text>
      <text x="194" y="50" fill="#475569" font-family="sans-serif" font-size="11">References</text>
      <text x="268" y="50" fill="#475569" font-family="sans-serif" font-size="11">Review</text>
      <text x="320" y="50" fill="#475569" font-family="sans-serif" font-size="11">View</text>

      <!-- Contextual Ribbon Tab Highlight (Pin 1) -->
      <rect x="380" y="32" width="130" height="28" rx="2" fill="#FEF3C7" stroke="#F59E0B" stroke-width="1.5" />
      <text x="390" y="50" fill="#92400E" font-family="sans-serif" font-size="11" font-weight="700">Picture Format</text>

      <!-- Ribbon Tools Panel -->
      <rect x="0" y="60" width="760" height="48" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="1" />
      <line x1="380" y1="60" x2="380" y2="108" stroke="#FDE68A" stroke-width="2" />
      <text x="395" y="80" fill="#1E293B" font-family="sans-serif" font-size="11">Wrap Text</text>
      <text x="395" y="98" fill="#64748B" font-family="sans-serif" font-size="10">Position ▾</text>
      <text x="465" y="80" fill="#1E293B" font-family="sans-serif" font-size="11">Align ▾</text>
      <text x="465" y="98" fill="#64748B" font-family="sans-serif" font-size="10">Group ▾</text>
      <line x1="520" y1="60" x2="520" y2="108" stroke="#E2E8F0" stroke-width="1" />

      <!-- Document Page Area -->
      <rect x="130" y="125" width="500" height="275" rx="3" fill="#FFFFFF" stroke="#94A3B8" stroke-width="1" />

      <!-- Text River Paragraphs -->
      <line x1="170" y1="155" x2="440" y2="155" stroke="#94A3B8" stroke-width="4" stroke-linecap="round" />
      <line x1="170" y1="170" x2="400" y2="170" stroke="#CBD5E1" stroke-width="3" stroke-linecap="round" />
      <line x1="170" y1="185" x2="380" y2="185" stroke="#CBD5E1" stroke-width="3" stroke-linecap="round" />

      <!-- Anchored Selected Object Box -->
      <rect x="420" y="165" width="160" height="120" rx="4" fill="#F8FAFC" stroke="#1D4ED8" stroke-width="2" stroke-dasharray="4,2" />
      <rect x="430" y="175" width="140" height="100" rx="2" fill="#E2E8F0" />
      <circle cx="500" cy="215" r="16" fill="#93C5FD" />
      <path d="M445 260 L480 230 L520 255 L560 220" stroke="#1D4ED8" stroke-width="2" fill="none" />

      <!-- Anchor Icon (attached to paragraph) -->
      <circle cx="155" cy="170" r="10" fill="#EFF6FF" stroke="#1D4ED8" stroke-width="1.5" />
      <text x="151" y="174" fill="#1D4ED8" font-size="12">⚓</text>
      <!-- Dotted tether from anchor to object -->
      <line x1="165" y1="170" x2="420" y2="175" stroke="#1D4ED8" stroke-width="1.5" stroke-dasharray="3,3" />

      <!-- Floating Layout Options Arch (Pin 2) -->
      <g transform="translate(585, 160)">
        <rect x="0" y="0" width="28" height="28" rx="4" fill="#FFFFFF" stroke="#1D4ED8" stroke-width="1.5" />
        <path d="M7 21 A 7 7 0 0 1 21 21" stroke="#1D4ED8" stroke-width="2" fill="none" />
      </g>

      <!-- Right-Click Context Menu Mockup (Pin 3) -->
      <g transform="translate(260, 220)">
        <rect x="0" y="0" width="145" height="115" rx="4" fill="#FFFFFF" stroke="#64748B" stroke-width="1.5" filter="drop-shadow(0 4px 6px rgb(0 0 0 / 0.1))" />
        <text x="14" y="22" fill="#475569" font-family="sans-serif" font-size="11">Cut</text>
        <text x="14" y="42" fill="#475569" font-family="sans-serif" font-size="11">Copy</text>
        <line x1="5" y1="52" x2="140" y2="52" stroke="#E2E8F0" stroke-width="1" />
        <rect x="5" y="56" width="135" height="22" rx="2" fill="#EFF6FF" />
        <text x="14" y="71" fill="#1D4ED8" font-family="sans-serif" font-size="11" font-weight="700">Wrap Text ▸</text>
        <text x="14" y="98" fill="#475569" font-family="sans-serif" font-size="11">Format Shape...</text>
      </g>

      <!-- Lower paragraphs flowing around -->
      <line x1="170" y1="310" x2="400" y2="310" stroke="#CBD5E1" stroke-width="3" stroke-linecap="round" />
      <line x1="170" y1="325" x2="580" y2="325" stroke="#CBD5E1" stroke-width="3" stroke-linecap="round" />
      <line x1="170" y1="340" x2="540" y2="340" stroke="#CBD5E1" stroke-width="3" stroke-linecap="round" />
    </svg>

    <!-- Overlay Hotspot Pins -->
    <div class="hotspot-pins-layer" aria-label="Interactive Word UI Hotspots">
      {hotspots.map((hotspot) => (
        <button
          type="button"
          class="hotspot-pin"
          id={`pin-${hotspot.id}`}
          popovertarget={hotspot.id}
          style={`--pin-left: ${hotspot.xPercent}%; --pin-top: ${hotspot.yPercent}%; anchor-name: --anchor-${hotspot.id};`}
          aria-haspopup="dialog"
          aria-label={`Hotspot ${hotspot.number}: ${hotspot.title}`}
        >
          <span class="pin-badge" aria-hidden="true">{hotspot.number}</span>
          <span class="pin-pulse" aria-hidden="true"></span>
        </button>
      ))}
    </div>

    <!-- Positioned Popovers with Native Popover API & Anchor Positioning -->
    {hotspots.map((hotspot) => (
      <div
        id={hotspot.id}
        class="hotspot-popover"
        popover="auto"
        style={`position-anchor: --anchor-${hotspot.id};`}
        aria-labelledby={`title-${hotspot.id}`}
      >
        <div class="popover-header">
          <span class="badge badge-ribbon">{hotspot.badge}</span>
          <button
            type="button"
            class="btn-popover-close"
            popovertarget={hotspot.id}
            popovertargetaction="hide"
            aria-label="Close callout"
          >
            ✕
          </button>
        </div>

        <h4 id={`title-${hotspot.id}`} class="popover-title">
          {hotspot.number}. {hotspot.title}
        </h4>

        <p class="popover-summary">{hotspot.summary}</p>

        <div class="popover-tip">
          <strong class="tip-label">Word Tip:</strong> {hotspot.tip}
        </div>

        {hotspot.ribbonRoute && (
          <div class="popover-route">
            <span class="route-label">Path:</span>
            <div class="route-steps">
              {hotspot.ribbonRoute.map((step, idx) => (
                <span class="route-chip">
                  {step}
                  {idx < (hotspot.ribbonRoute?.length || 0) - 1 && " →"}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .hotspot-map-container {
    margin-block: var(--space-8);
    background-color: var(--surface-card);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: 0 2px 4px rgb(0 0 0 / 4%);
  }

  .hotspot-intro {
    margin-block-end: var(--space-4);
  }

  .hotspot-title {
    margin: 0 0 var(--space-2) 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--ink-primary);
  }

  .title-icon {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    color: var(--accent-word);
    flex-shrink: 0;
  }

  .hotspot-intro-text {
    margin: 0;
    font-size: var(--font-size-base);
    color: var(--ink-secondary);
    line-height: var(--line-height-normal);
  }

  .schematic-canvas {
    position: relative;
    inline-size: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: #F8FAFC;
    border: 1px solid var(--border-subtle);
  }

  .word-schematic-svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
    height: auto;
  }

  .hotspot-pins-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hotspot-pin {
    position: absolute;
    left: var(--pin-left);
    top: var(--pin-top);
    transform: translate(-50%, -50%);
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--target-min-size);
    min-block-size: var(--target-min-size);
    inline-size: var(--target-min-size);
    block-size: var(--target-min-size);
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    border-radius: var(--radius-pill);
    touch-action: manipulation;
  }

  .pin-badge {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: var(--radius-pill);
    background-color: #DC2626;
    color: #FFFFFF;
    font-weight: 800;
    font-size: 1rem;
    box-shadow: 0 2px 4px rgb(0 0 0 / 25%);
    border: 2px solid #FFFFFF;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .hotspot-pin:hover .pin-badge,
  .hotspot-pin:focus-visible .pin-badge {
    transform: scale(1.15);
    background-color: #B91C1C;
  }

  .pin-pulse {
    position: absolute;
    z-index: 1;
    inset: 0.25rem;
    border-radius: var(--radius-pill);
    background-color: #EF4444;
    opacity: 0.5;
    animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(0.9);
      opacity: 0.8;
    }

    80%, 100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  /* Popover Styling */
  .hotspot-popover {
    margin: 0;
    padding: var(--space-4);
    inline-size: min(22rem, 90vw);
    background-color: var(--surface-card);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 15%), 0 4px 6px -4px rgb(0 0 0 / 10%);
    color: var(--ink-primary);
    z-index: 50;
  }

  /* Anchor positioning for modern browsers */
  @supports (anchor-name: --a) {
    .hotspot-popover {
      position: fixed;
      position-area: block-start;
      position-try-fallbacks: flip-block, flip-inline;
      margin-block-end: var(--space-2);
    }
  }

  /* Clean centered / floating modal fallback for browsers without CSS anchor positioning */
  @supports not (anchor-name: --a) {
    .hotspot-popover {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
  }

  .popover-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-block-end: var(--space-2);
  }

  .btn-popover-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--target-min-size);
    min-block-size: var(--target-min-size);
    padding: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    background-color: var(--surface-subtle);
    color: var(--ink-primary);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
  }

  .btn-popover-close:hover {
    background-color: var(--surface-hover);
    border-color: var(--ink-primary);
  }

  .popover-title {
    margin: 0 0 var(--space-2) 0;
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--ink-primary);
  }

  .popover-summary {
    margin: 0 0 var(--space-3) 0;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
    color: var(--ink-secondary);
  }

  .popover-tip {
    padding: var(--space-2) var(--space-3);
    background-color: var(--accent-word-bg);
    border-inline-start: 3px solid var(--accent-word);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    color: var(--ink-primary);
    line-height: var(--line-height-normal);
    margin-block-end: var(--space-2);
  }

  .tip-label {
    color: var(--accent-word);
  }

  .popover-route {
    font-size: var(--font-size-xs);
    color: var(--ink-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    margin-block-start: var(--space-2);
  }

  .route-label {
    font-weight: 700;
  }

  .route-chip {
    color: var(--ink-secondary);
    font-weight: 600;
  }

  @media (forced-colors: active) {
    .pin-badge {
      background-color: Highlight;
      color: HighlightText;
      border: 2px solid ButtonText;
    }

    .hotspot-popover,
    .btn-popover-close {
      border: 1px solid ButtonText;
    }
  }
</style>
