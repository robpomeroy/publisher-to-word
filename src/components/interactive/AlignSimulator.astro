---
import {
  INITIAL_ALIGN_ITEMS,
  getAlignStatus,
  MARGIN_BOUNDS,
} from "../../utils/simulators";

const initialStatus = getAlignStatus("reset", "margin");
---

<div class="align-simulator card" id="align-simulator">
  <div class="simulator-header">
    <div class="header-text">
      <h3 id="align-sim-title" class="simulator-title">
        <svg
          class="sim-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="21" y1="10" x2="3" y2="10"></line>
          <line x1="21" y1="6" x2="3" y2="6"></line>
          <line x1="21" y1="14" x2="3" y2="14"></line>
          <line x1="21" y1="18" x2="3" y2="18"></line>
        </svg>
        Word Alignment & Distribution Simulator
      </h3>
      <p class="simulator-subtitle">
        Publisher let you drag objects anywhere. In Word, the Align menu lines up multiple items perfectly relative to the page, the margins, or each other.
      </p>
    </div>
  </div>

  <!-- Reference Target Selector -->
  <div class="target-selector-row">
    <span class="target-label" id="align-target-label">Alignment Reference:</span>
    <div class="btn-group" role="radiogroup" aria-labelledby="align-target-label">
      <button
        type="button"
        class="btn-target is-active"
        data-target="margin"
        role="radio"
        aria-checked="true"
        tabindex="0"
      >
        Align to Margin (Default)
      </button>
      <button
        type="button"
        class="btn-target"
        data-target="page"
        role="radio"
        aria-checked="false"
        tabindex="-1"
      >
        Align to Page
      </button>
      <button
        type="button"
        class="btn-target"
        data-target="selected"
        role="radio"
        aria-checked="false"
        tabindex="-1"
      >
        Align Selected Objects
      </button>
    </div>
  </div>

  <!-- Action Toolstrip -->
  <div class="action-toolstrip" role="toolbar" aria-label="Alignment actions">
    <button type="button" class="btn-align-action" data-action="left">
      <svg class="btn-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M3 3h2v14H3V3zm4 3h10v3H7V6zm0 5h7v3H7v-3z" />
      </svg>
      Align Left
    </button>
    <button type="button" class="btn-align-action" data-action="center">
      <svg class="btn-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M9 3h2v14H9V3zM4 6h12v3H4V6zm2 5h8v3H6v-3z" />
      </svg>
      Align Centre
    </button>
    <button type="button" class="btn-align-action" data-action="right">
      <svg class="btn-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M15 3h2v14h-2V3zM3 6h10v3H3V6zm3 5h7v3H6v-3z" />
      </svg>
      Align Right
    </button>
    <button type="button" class="btn-align-action" data-action="top">
      <svg class="btn-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M3 3h14v2H3V3zm3 4v10h3V7H6zm5 0v7h3V7h-3z" />
      </svg>
      Align Top
    </button>
    <button type="button" class="btn-align-action" data-action="distribute">
      <svg class="btn-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M2 3h2v14H2V3zm14 0h2v14h-2V3zM7 6h6v8H7V6z" />
      </svg>
      Distribute Horizontally
    </button>
    <button type="button" class="btn-align-action btn-reset" data-action="reset">
      Scatter (Reset)
    </button>
  </div>

  <!-- Interactive Mock Document Canvas -->
  <div class="align-canvas-wrapper">
    <div class="canvas-ruler-bar">
      <span class="ruler-info">Word Page Canvas (320 × 200 pt)</span>
      <span class="guide-legend">
        <span class="legend-swatch margin-swatch" aria-hidden="true"></span> Margin Boundary (40 pt)
      </span>
    </div>

    <div class="align-canvas" id="align-canvas">
      <!-- Margin Boundary Guide Box -->
      <div
        class="margin-guide-boundary"
        style={`left: ${MARGIN_BOUNDS.left}px; top: ${MARGIN_BOUNDS.top}px; width: ${MARGIN_BOUNDS.width}px; height: ${MARGIN_BOUNDS.height}px;`}
      >
        <span class="margin-watermark">Printable Margin</span>
      </div>

      <!-- Smart Alignment Guide Line (Lights up on alignment) -->
      <div class="smart-guide-line" id="smart-guide-line" aria-hidden="true"></div>

      <!-- 3 Distinct Layout Objects -->
      {INITIAL_ALIGN_ITEMS.map((item) => (
        <div
          class="canvas-item"
          id={`align-item-${item.id}`}
          style={`transform: translate(${item.x}px, ${item.y}px); width: ${item.width}px; height: ${item.height}px;`}
        >
          <div class="item-inner">
            <span class="item-badge">{item.name}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Active Status Announcement -->
  <div class="status-callout" id="align-status-callout">
    <strong class="status-prefix">Active Status:</strong>
    <span id="align-status-text">Objects are in scattered starting positions.</span>
  </div>

  <div class="sr-only" role="status" aria-live="polite" id="align-live-status">
    {initialStatus}
  </div>
</div>

<script>
  import {
    alignObjects,
    cloneItems,
    getAlignStatus,
    INITIAL_ALIGN_ITEMS,
    type AlignAction,
    type AlignItem,
    type AlignTarget,
  } from "../../utils/simulators";

  const root = document.getElementById("align-simulator");
  if (root) {
    let currentTarget: AlignTarget = "margin";
    let items: AlignItem[] = cloneItems(INITIAL_ALIGN_ITEMS);

    const targetBtns = root.querySelectorAll<HTMLButtonElement>(".btn-target");
    const actionBtns = root.querySelectorAll<HTMLButtonElement>(".btn-align-action");
    const smartGuide = root.querySelector<HTMLDivElement>("#smart-guide-line");
    const statusText = root.querySelector<HTMLSpanElement>("#align-status-text");
    const liveStatus = root.querySelector<HTMLDivElement>("#align-live-status");

    function renderObjects(action: AlignAction) {
      items.forEach((item) => {
        const el = root?.querySelector<HTMLDivElement>(`#align-item-${item.id}`);
        if (el) {
          el.style.transform = `translate(${item.x}px, ${item.y}px)`;
        }
      });

      // Smart alignment guide indication
      if (smartGuide) {
        if (action === "left") {
          smartGuide.style.display = "block";
          smartGuide.style.left = `${items[0].x}px`;
          smartGuide.style.top = "0";
          smartGuide.style.width = "2px";
          smartGuide.style.height = "100%";
        } else if (action === "top") {
          smartGuide.style.display = "block";
          smartGuide.style.left = "0";
          smartGuide.style.top = `${items[0].y}px`;
          smartGuide.style.width = "100%";
          smartGuide.style.height = "2px";
        } else {
          smartGuide.style.display = "none";
        }
      }

      // Update readable status
      const desc = getAlignStatus(action, currentTarget);
      if (statusText) statusText.textContent = desc;
      if (liveStatus) liveStatus.textContent = desc;
    }

    function selectTarget(btn: HTMLButtonElement) {
      const t = btn.getAttribute("data-target") as AlignTarget;
      if (!t) return;
      currentTarget = t;
      targetBtns.forEach((b) => {
        const isActive = b === btn;
        b.classList.toggle("is-active", isActive);
        b.setAttribute("aria-checked", isActive ? "true" : "false");
        b.setAttribute("tabindex", isActive ? "0" : "-1");
      });
      btn.focus();
    }

    targetBtns.forEach((btn, idx) => {
      btn.addEventListener("click", () => selectTarget(btn));
      btn.addEventListener("keydown", (e) => {
        let nextIdx = -1;
        if (e.key === "ArrowRight" || e.key === "ArrowDown") {
          e.preventDefault();
          nextIdx = (idx + 1) % targetBtns.length;
        } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
          e.preventDefault();
          nextIdx = (idx - 1 + targetBtns.length) % targetBtns.length;
        }
        if (nextIdx >= 0) {
          selectTarget(targetBtns[nextIdx]);
        }
      });
    });

    actionBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const action = btn.getAttribute("data-action") as AlignAction;
        if (action) {
          items = alignObjects(items, action, currentTarget);
          renderObjects(action);
        }
      });
    });
  }
</script>

<style>
  .align-simulator {
    margin-block: var(--space-8);
    padding: var(--space-6);
  }

  .simulator-header {
    margin-block-end: var(--space-5);
  }

  .simulator-title {
    margin: 0 0 var(--space-2) 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--ink-primary);
  }

  .sim-icon {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    color: var(--accent-word);
    flex-shrink: 0;
  }

  .simulator-subtitle {
    margin: 0;
    font-size: var(--font-size-base);
    color: var(--ink-secondary);
    line-height: var(--line-height-normal);
  }

  /* Target Selector */
  .target-selector-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-block-end: var(--space-4);
  }

  @media (min-width: 640px) {
    .target-selector-row {
      flex-direction: row;
      align-items: center;
    }
  }

  .target-label {
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--ink-secondary);
    min-inline-size: 10rem;
  }

  .btn-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .btn-target {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--target-min-size);
    min-inline-size: var(--target-min-size);
    padding-inline: var(--space-4);
    font-family: inherit;
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--ink-primary);
    background-color: var(--surface-card);
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-target:hover {
    background-color: var(--surface-hover);
    border-color: var(--accent-word);
  }

  .btn-target.is-active {
    background-color: var(--accent-word);
    color: #FFFFFF;
    border-color: var(--accent-word);
  }

  /* Toolstrip */
  .action-toolstrip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-end: var(--space-5);
  }

  .btn-align-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-block-size: var(--target-min-size);
    min-inline-size: var(--target-min-size);
    padding-inline: var(--space-3);
    font-family: inherit;
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--ink-primary);
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-align-action:hover {
    background-color: var(--surface-hover);
    border-color: var(--ink-primary);
  }

  .btn-icon {
    inline-size: 1rem;
    block-size: 1rem;
    color: var(--ink-secondary);
  }

  .btn-reset {
    margin-inline-start: auto;
    background-color: #FEE2E2;
    color: #991B1B;
    border-color: #FCA5A5;
  }

  .btn-reset:hover {
    background-color: #FECDCD;
  }

  /* Mock Canvas Area */
  .align-canvas-wrapper {
    background-color: #FFFFFF;
    border: 1px solid var(--border-ui);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 10%);
    overflow: hidden;
    margin-block-end: var(--space-4);
  }

  .canvas-ruler-bar {
    background-color: var(--surface-subtle);
    border-block-end: 1px solid var(--border-subtle);
    padding: var(--space-2) var(--space-4);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--font-size-xs);
    color: var(--ink-muted);
  }

  .guide-legend {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }

  .margin-swatch {
    display: inline-block;
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border: 1px dashed var(--accent-word);
    background-color: #EFF6FF;
  }

  .align-canvas {
    position: relative;
    inline-size: 320px;
    max-inline-size: 100%;
    block-size: 200px;
    margin-inline: auto;
    background-color: #FAF9F6;
  }

  .margin-guide-boundary {
    position: absolute;
    border: 1px dashed var(--accent-word-border);
    background-color: rgb(239 246 255 / 40%);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 0.25rem;
    pointer-events: none;
  }

  .margin-watermark {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--accent-word-border);
    text-transform: uppercase;
  }

  .smart-guide-line {
    position: absolute;
    background-color: #16A34A;
    box-shadow: 0 0 4px #22C55E;
    z-index: 10;
    display: none;
  }

  .canvas-item {
    position: absolute;
    top: 0;
    left: 0;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .item-inner {
    inline-size: 100%;
    block-size: 100%;
    background-color: var(--surface-card);
    border: 1.5px solid var(--ink-primary);
    border-radius: var(--radius-sm);
    box-shadow: 0 2px 4px rgb(0 0 0 / 10%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    text-align: center;
  }

  .item-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ink-primary);
    line-height: 1.1;
  }

  #align-item-box-1 .item-inner {
    border-color: var(--accent-word);
    background-color: #EFF6FF;
  }

  #align-item-box-2 .item-inner {
    border-color: var(--accent-publisher);
    background-color: #F0FDFA;
  }

  #align-item-box-3 .item-inner {
    border-color: var(--accent-tip);
    background-color: #FFFBEB;
  }

  .status-callout {
    font-size: var(--font-size-sm);
    color: var(--ink-secondary);
    padding: var(--space-2) var(--space-3);
    background-color: var(--surface-subtle);
    border-radius: var(--radius-sm);
  }

  .status-prefix {
    color: var(--ink-primary);
  }

  @media (forced-colors: active) {
    .btn-target,
    .btn-align-action {
      border: 1px solid ButtonText !important;
    }

    .btn-target.is-active {
      background-color: Highlight;
      color: HighlightText;
    }

    .item-inner {
      border: 1.5px solid ButtonText !important;
    }
  }
</style>
